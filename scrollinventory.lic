# frozen_string_literal: true

require 'json'
require 'fileutils'
require 'set'

=begin

scrollinventory.lic (Scroll Inventory, alias ;scriv) keeps a running ledger of every scroll you own
and the spells written on them, so you can see at a glance what you can invoke and how much of it.
It reads your scrolls once, remembers them, and quietly tracks every INVOKE you make (by hand or from
another script) so each spell gets a cumulative use count. It never casts or invokes anything itself.

Scrolls are not tracked by a single item id. A scroll's id changes every time it passes through a
locker, and you will often own several scrolls with the same name but different spells. So each scroll
is remembered by its name plus the exact set of spells read from it, and is re-matched to its history
whenever it turns up again under a new id.

The following inputs are available:
  ;scriv                       - refresh (read any new scrolls) and print the spell summary
  ;scriv <spell number>        - ONLY the scrolls holding that spell (e.g. ;scriv 1115)
  ;scriv list                  - print the last summary without touching the game
  ;scriv detail                - every tracked scroll with its spells, location and use counts
  ;scriv spell <num|name>      - same as above, by number or part of the spell name
  ;scriv scan                  - re-read every scroll you are carrying, not just new ones
  ;scriv setup                 - show the setup options and their current values
  ;scriv set pristine <bags>   - bags of never-invoked scrolls, shown teal as *name
  ;scriv set normal <bags>     - bags of used scrolls, shown plain
  ;scriv set infused <bags>    - bags of sorcerer-infused scrolls, shown green as !name
  ;scriv set show <kinds>      - which of pristine, normal, infused ;scriv lists (any combination)
  ;scriv forget <#>            - drop one scroll from the ledger (the # shown by detail)
  ;scriv prune                 - drop every scroll marked stored (lockers etc.) from the ledger
  ;scriv help                  - command list
  ;scrollinventory works exactly the same as ;scriv.

Enhanced by ;invdb (Xanlin): when its database exists, scriv reads it (read-only) to search only the bags
that hold scrolls, to retire scrolls that have left your lockers, and to tell you about locker scrolls it
has not read yet. Without it, scriv quietly searches your bags in the background on every run.

      author: Kyrandos
      Other scripts: Combatical, Merchantical, Loresang, VolnRestore2, isharpie
      game: gs
      tags: scrolls, invoke, spells, inventory, tracking, arcane symbols
      version: 1.3.1
      required: Lich > 5.0

      \\Version\\
      1.0.0 10/28/2026 - initial release: scroll ledger keyed by name + spell set, invoke/use tracking,
                         spell summary with scroll names and cumulative counts, ;scriv alias
      1.1.0 10/28/2026 - summary reads "(1115) Wither 3 scrolls - names"; ;scriv <spell number>; setup and
                         set container; invdb integration; silent background bag search without invdb
      1.2.0 10/28/2026 - pristine/normal/infused bags (set pristine|normal|infused), *teal and !green markers,
                         and set show to choose which kinds are listed; set container now means normal
      1.2.1 10/28/2026 - a scroll seen invoked this session stays normal even if put back in a pristine bag
      1.3.0 10/28/2026 - scroll names are clickable: reads that scroll, or each scroll in a stack holding the
                         listed spell, by current game id
      1.3.1 10/28/2026 - scans send reads and bag looks as one batch instead of one command at a time:
                         near-instant, and no more screens of blank lines while scrolls are read

=end

module ScrollInventory
  VERSION = '1.3.1'.freeze

  SCROLL_NOUNS = %w[scroll vellum paper papyrus parchment palimpsest].freeze
  ALIASES      = %w[scrollinventory scriv].freeze

  # Players keep scrolls in separate bags by condition: never invoked (pristine),
  # already used (normal), and sorcerer-infused (see gswiki Scroll_Infusion_(714)).
  KINDS       = %w[pristine normal infused].freeze
  KIND_MARK   = { 'pristine' => '*', 'normal' => '', 'infused' => '!' }.freeze
  KIND_PRESET = { 'pristine' => 'whisper', 'infused' => 'speech' }.freeze # teal / green, as isharpie's colors

  EDUBARBARIAN_DIR = File.join(LICH_DIR, 'EduBarbarian').freeze
  INVDB_PATH       = File.join(LICH_DIR, 'data', 'inv.db3').freeze

  CAPTURE_HOOK_ID  = 'scriv_capture'.freeze
  OBSERVER_HOOK_ID = 'scriv_observer'.freeze
  UPSTREAM_HOOK_ID = 'scriv_upstream'.freeze

  # $lich_char_regex (','|';') because Lich uses ',' as the script-trigger
  # character on the Genie frontend (the mac-compatible client).
  HOOK_CMD_RX = /^(?:<c>)?#{$lich_char_regex}(?:#{ALIASES.map { |a| Regexp.escape(a) }.join('|')})(?:\s+(.*))?$/i

  # One entry of a server-side container listing:
  #   <inv id='CONTAINER'> a <a exist="ID" noun="NOUN">TAG_TEXT</a></inv>
  INV_LIST_RX = /<inv id='([^']+)'>\s*(?:an?|some|the)?\s*<a exist="(\d+)" noun="([^"]*)">([^<]*)<\/a>/.freeze

  # Isolating a command's response (same approach as isharpie/merchantical):
  # right after the command a sentinel that can never succeed is sent; the game
  # answers in order, so seeing its failure line proves the real response ended.
  SENTINEL_CMD      = 'look at #0'.freeze
  SENTINEL_RX       = /could not find what you were referring to/i.freeze
  LNET_LINE_RX      = /\A\[[A-Za-z][\w' -]*\]\s+[A-Za-z][\w' -]*:\s*"/.freeze
  BROADCAST_LINE_RX = /\A\*\s*[A-Za-z].*[.!]\s*\z/.freeze

  # Invoke messaging (gswiki Scroll / Arcane Symbols).
  INVOKE_OK_RX  = /You raise (?:the |your |an? )?(.+?) and gesture to invoke the (.+?) spell\./.freeze
  VIBRANT_OK_RX = /the ink leaps from the page and seeps into your skin/i.freeze
  BLANK_RX      = /leaving a blank space where the (.+?) spell had previously been written/i.freeze
  INVOKE_CMD_RX = /\Ainvoke\s+(\d{2,4})\b/i.freeze
  PENDING_TTL   = 15 # seconds an upstream "invoke <num>" stays attributable
  READ_BATCH    = 12 # scrolls read per round trip

  CMD_QUEUE   = Queue.new
  EVENT_QUEUE = Queue.new

  @data            = nil
  @dirty           = false
  @non_containers  = Set.new
  @pending_invoke  = nil
  @used_uids       = Set.new # scrolls seen invoked this session; never saved
  @warned_closed   = Set.new

  ## ---- persisted ledger --------------------------------------------------

  def self.data_path
    char = XMLData.name.to_s.downcase.gsub(/[^a-z0-9]+/, '_').gsub(/\A_+|_+\z/, '')
    File.join(EDUBARBARIAN_DIR, "scrollinventory_#{char}.json")
  end

  def self.data
    @data ||= load_data
  end

  def self.load_data
    blank = { next_uid: 1, records: [], usage: {}, settings: { pristine: [], normal: [], infused: [], show: [] } }
    return blank unless File.exist?(data_path)

    loaded = JSON.parse(File.read(data_path), symbolize_names: true)
    loaded = blank.merge(loaded)
    s = loaded[:settings] ||= {}
    s[:normal] ||= Array(s.delete(:containers)) # 1.1.0 kept one undifferentiated container list
    s[:pristine] ||= []
    s[:infused] ||= []
    s[:show] ||= []
    loaded
  rescue StandardError => e
    say "could not read #{data_path} (#{e.class}) - starting a fresh ledger"
    blank
  end

  def self.save_data!
    FileUtils.mkdir_p(EDUBARBARIAN_DIR)
    File.write(data_path, JSON.pretty_generate(data))
  rescue StandardError => e
    say "could not save to #{data_path}: #{e.class}"
  end

  def self.records
    data[:records]
  end

  def self.usage
    data[:usage]
  end

  # Every container the player named, whatever its kind.
  def self.configured_containers
    KINDS.flat_map { |k| kind_containers(k) }
  end

  def self.kind_containers(kind)
    Array(data.dig(:settings, kind.to_sym))
  end

  # Pristine bags win over infused, infused over normal; anything unnamed is normal.
  def self.kind_for(item)
    %w[pristine infused].find { |k| kind_containers(k).any? { |c| name_match?(item, c) } } || 'normal'
  end

  # The bag decides a scroll's kind, except a pristine bag can't hold a scroll
  # we have watched being invoked.
  def self.effective_kind(rec, bag_kind)
    bag_kind == 'pristine' && @used_uids.include?(rec[:uid]) ? 'normal' : bag_kind
  end

  # Clickable text that runs ";scriv read <uids>". The ledger number, not the
  # game id, goes in the link: ids change when a scroll visits a locker, so the
  # current id is looked up when the link is clicked. $clean_lich_char is the
  # frontend's script trigger (',' on Genie).
  def self.link(uids, text)
    trigger = defined?($clean_lich_char) && $clean_lich_char ? $clean_lich_char : ';'
    "<d cmd=\"#{trigger}#{ALIASES.last} read #{uids.join(' ')}\">#{text}</d>"
  end

  def self.read_linked(text)
    text.scan(/\d+/).map(&:to_i).uniq.each_with_index do |uid, i|
      rec = records.find { |r| r[:uid] == uid }
      next say("scroll ##{uid} is no longer in the ledger - run ;scriv to refresh") unless rec
      next say("#{rec[:name]} is stored - take it out of storage to read it") unless rec[:status] == 'carried' && rec[:id]

      pause 0.3 if i.positive?
      fput "read ##{rec[:id]}"
      waitrt?
    end
  end

  def self.shown_kinds
    shown = Array(data.dig(:settings, :show)).map(&:to_s) & KINDS
    shown.empty? ? KINDS : shown
  end

  # Scroll text for the summary: "*inky vellum" (pristine, teal), "!inky vellum"
  # (infused, green), plain for normal.
  def self.paint(kind, text)
    preset = KIND_PRESET[kind]
    marked = "#{KIND_MARK[kind]}#{text}"
    preset ? "<preset id='#{preset}'>#{marked}</preset>" : marked
  end

  def self.key(num)
    num.to_s.to_sym
  end

  ## ---- helpers -------------------------------------------------------------

  def self.say(message)
    _respond Lich::Messaging.msg_format('whisper', "[ScrollInventory: #{message}]", encode: false)
  end

  def self.strip_tags(line)
    line.to_s.gsub(/<[^>]*>/, '').gsub('&gt;', '>').gsub('&lt;', '<').gsub('&amp;', '&').strip
  end

  def self.scroll_obj?(obj)
    obj && SCROLL_NOUNS.include?(obj.noun.to_s)
  end

  def self.spell_nums(spells)
    spells.map { |s| s[:num] }.sort
  end

  def self.find_spell(rec, num, name)
    rec[:spells].find do |s|
      (num && s[:num] == num.to_i) || (name && s[:name].to_s.casecmp?(name.to_s))
    end
  end

  def self.lookup_num(name)
    hit = usage.find { |_k, v| v[:name].to_s.casecmp?(name.to_s) }
    return hit[0].to_s.to_i if hit && hit[0].to_s =~ /\A\d+\z/

    records.each { |r| r[:spells].each { |s| return s[:num] if s[:name].to_s.casecmp?(name.to_s) } }
    nil
  end

  ## ---- command capture -------------------------------------------------------

  # Raw response lines for one command, never shown to the player.
  def self.capture(cmd)
    capture_many([cmd]).first
  end

  # Raw response lines for each command, one array per command, never shown to
  # the player. Every command is sent at once, each followed by the sentinel;
  # the game answers in order, so the sentinel's failure line closes each
  # command's response. One batch costs one round trip rather than one per
  # command - reading a whole satchel of scrolls takes about a second. A silent
  # game (no sentinel within the limit) leaves the remaining arrays empty.
  def self.capture_many(cmds)
    results = cmds.map { [] }
    return results if cmds.empty?

    own_miss = Array.new(cmds.size, false)
    idx = 0
    in_push = false
    last_activity = Time.now
    DownstreamHook.add(CAPTURE_HOOK_ID, proc { |line|
      next line if idx >= cmds.size
      next nil if line.strip.empty? # bare blank lines carry nothing; hiding them keeps the window clean

      was_in_push = in_push
      in_push = true  if line =~ /<pushStream/
      in_push = false if line =~ /<popStream/
      stripped = strip_tags(line)
      if was_in_push || line =~ /<pushStream/ || line =~ /<prompt[\s>]/ || stripped.empty? ||
         stripped =~ LNET_LINE_RX || stripped =~ BROADCAST_LINE_RX
        next line
      end

      last_activity = Time.now
      if stripped =~ SENTINEL_RX
        if results[idx].empty? && !own_miss[idx]
          # The command's own failure (e.g. a stale id), not the sentinel's.
          own_miss[idx] = true
          results[idx] << line
        else
          idx += 1
        end
        next nil
      end

      results[idx] << line
      nil
    })
    previous_silent = Script.current.silent
    begin
      Script.current.silent = true
      cmds.each do |cmd|
        put cmd
        put SENTINEL_CMD
      end
      started = Time.now
      limit = 4 + cmds.size * 0.5
      pause 0.05 until idx >= cmds.size || Time.now - started > limit || Time.now - last_activity > 3
      waitrt?
      pause 0.05
    ensure
      Script.current.silent = previous_silent
      DownstreamHook.remove(CAPTURE_HOOK_ID)
    end
    results
  end

  ## ---- finding and reading scrolls -----------------------------------------

  # Scrolls in your hands and in the top level of every container you wear.
  # Returns [scrolls, complete]; complete is false when any container could
  # not be inspected, so a scroll that merely wasn't seen is never declared stored.
  def self.gather_scrolls(deep: false)
    found = []
    complete = true
    searched = Set.new

    [GameObj.right_hand, GameObj.left_hand].each do |obj|
      found << { id: obj.id.to_s, name: obj.name.to_s, where: 'hand' } if scroll_obj?(obj)
    end

    items = search_items(deep).reject { |item| @non_containers.include?(item.id.to_s) }
    replies = capture_many(items.map { |item| "look in ##{item.id}" })

    items.each_with_index do |item, i|
      searched << item.name.to_s
      raw = replies[i].join("\n")
      entries = raw.scan(INV_LIST_RX).select { |cid, *| cid == item.id.to_s }
      if entries.empty?
        if raw =~ /nothing in|is empty|There is nothing/i
          next
        elsif raw =~ /\bclosed\b|need to open/i
          complete = false
          say "your #{item.noun} is closed - open it so its scrolls can be seen" if @warned_closed.add?(item.id.to_s)
        elsif raw.strip.empty?
          complete = false
        else
          @non_containers << item.id.to_s # armor, weapons, etc. - nothing to look in
        end
        next
      end

      entries.each do |_cid, eid, noun, text|
        next unless SCROLL_NOUNS.include?(noun)

        found << { id: eid, name: text.strip, where: item.name.to_s, kind: kind_for(item) }
      end
    end

    [found, complete, searched]
  end

  # "silver backpack" matches a worn item whose name holds every word (or whose
  # noun is the word), so an adjective narrows it and a bare noun still works.
  def self.name_match?(item, pattern)
    words = pattern.to_s.downcase.split
    return false if words.empty?

    name = item.name.to_s.downcase
    words.all? { |w| name.include?(w) || item.noun.to_s.downcase == w }
  end

  # Which worn items to look inside:
  #   1. the containers set with ;scriv set container, if any;
  #   2. otherwise, with invdb, only the bags invdb says hold scrolls plus the
  #      bags the ledger already knows (;scriv scan always searches them all);
  #   3. otherwise every worn item.
  def self.search_items(deep)
    inv = GameObj.inv.to_a
    unless configured_containers.empty?
      matched = inv.select { |i| configured_containers.any? { |c| name_match?(i, c) } }
      configured_containers.reject { |c| inv.any? { |i| name_match?(i, c) } }.each do |c|
        say "container \"#{c}\" isn't something you're wearing" if @warned_closed.add?("cfg:#{c}")
      end
      return matched
    end

    unless deep
      paths = invdb_scroll_paths
      if paths
        wanted = paths + records.select { |r| r[:status] == 'carried' }.map { |r| r[:container] }
        return inv.select { |i| wanted.any? { |w| name_match?(i, w) } }
      end
    end

    inv
  end

  ## ---- invdb (optional, read-only) -----------------------------------------

  # This character's scroll rows from invdb's database, or nil when invdb has
  # never been run / sqlite3 is unavailable / the character isn't in it.
  def self.invdb_rows
    return @invdb_cache if @invdb_cache_at && Time.now - @invdb_cache_at < 5
    return nil unless File.exist?(INVDB_PATH)

    begin
      require 'sqlite3'
    rescue LoadError
      return nil
    end

    rows = nil
    db = SQLite3::Database.new(INVDB_PATH, readonly: true)
    char = db.get_first_value('SELECT id FROM character WHERE name = ? COLLATE NOCASE', [XMLData.name.to_s])
    if char
      sql = 'SELECT i.name, i.noun, i.amount, i.path, COALESCE(l.type, \'\'), COALESCE(l.name, \'\'), i.timestamp ' \
            'FROM item i LEFT JOIN location l ON l.id = i.location_id WHERE i.character_id = ?'
      rows = []
      db.execute(sql, [char]).each do |name, noun, amount, path, ltype, lname, ts|
        next unless SCROLL_NOUNS.include?(noun)

        rows << { name: name.to_s, amount: amount.to_i, path: path.to_s, carried: ltype == 'inv', where: lname.to_s, ts: ts.to_i }
      end
    end
    @invdb_cache = rows
    @invdb_cache_at = Time.now
    rows
  rescue StandardError
    nil
  ensure
    db&.close
  end

  def self.invdb_scroll_paths
    rows = invdb_rows
    return nil unless rows

    rows.select { |r| r[:carried] && !r[:path].empty? }.map { |r| r[:path] }.uniq
  end

  # Retires "stored" scrolls that invdb says have left the lockers, and counts
  # locker scrolls invdb can see that the ledger has never read. A stored scroll
  # is only retired when invdb scanned your lockers after the scroll was stored.
  def self.reconcile_with_invdb
    @locker_unread = nil
    rows = invdb_rows
    return unless rows

    lockers = rows.reject { |r| r[:carried] }
    return if lockers.empty?

    verified_at = lockers.map { |r| r[:ts] }.max
    held = Hash.new(0)
    lockers.each { |r| held[r[:name].downcase] += r[:amount] }

    records.select { |r| r[:status] == 'stored' && !r[:unreadable] }.group_by { |r| r[:name].downcase }.each do |name, recs|
      checked = recs.select { |r| (r[:stored_at] || r[:last_seen]).to_i < verified_at }
      excess = [recs.size - held[name], checked.size].min
      next unless excess.positive?

      checked.sort_by { |r| r[:stored_at] || r[:last_seen] }.first(excess).each { |r| records.delete(r) }
      @dirty = true
    end

    ledger = Hash.new(0)
    records.each { |r| ledger[r[:name].downcase] += 1 if r[:status] == 'stored' }
    @locker_unread = held.sum { |name, n| [n - ledger[name], 0].max }
  end

  # [] when the scroll showed no spells (blank or unreadable), nil when the
  # game never answered.
  def self.read_scroll(id)
    read_scrolls([id])[id]
  end

  # {id => spells} for every id, read in batches so a bag of scrolls is not
  # read one round trip at a time.
  def self.read_scrolls(ids)
    out = {}
    ids.each_slice(READ_BATCH) do |slice|
      capture_many(slice.map { |id| "read ##{id}" }).each_with_index do |raw, i|
        lines = raw.map { |l| strip_tags(l) }.reject(&:empty?)
        gone = lines.all? { |l| l =~ SENTINEL_RX } # the scroll isn't there any more: no answer, not a blank scroll
        out[slice[i]] = gone ? nil : parse_spells(lines)
      end
    end
    out
  end

  # Read output lists spells as "(101) Spirit Warding I"; spells written in
  # vibrant ink carry an "in vibrant ink" tail.
  def self.parse_spells(lines)
    spells = lines.filter_map do |text|
      if (m = text.match(/\((\d{2,4})\)\s+(\S.*)\z/))
        num = m[1]
        name = m[2]
      elsif (m = text.match(/\A(\S.*?)\s+\((\d{2,4})\)\z/))
        name = m[1]
        num = m[2]
      else
        next
      end
      vibrant = name.match?(/vibrant ink/i)
      name = name.sub(/\s*,?\s*(?:written\s+)?in vibrant ink\.?\z/i, '').sub(/[.,]\z/, '').strip
      { num: num.to_i, name: name, vibrant: vibrant }
    end
    spells.uniq { |s| s[:num] }
  end

  ## ---- the refresh pass ------------------------------------------------------

  def self.refresh(deep: false)
    found, complete, searched = gather_scrolls(deep: deep)
    now = Time.now.to_i
    claimed = Set.new
    to_read = []

    found.each do |scroll|
      rec = records.find { |r| r[:id] == scroll[:id] && r[:name].to_s.casecmp?(scroll[:name]) }
      if rec
        claimed << rec[:uid]
        rec[:status] = 'carried'
        rec[:container] = scroll[:where]
        rec[:kind] = effective_kind(rec, scroll[:kind]) if scroll[:kind] # a scroll in hand keeps its bag's kind
        rec[:last_seen] = now
        to_read << [scroll, rec] if deep || rec[:stale]
      else
        to_read << [scroll, nil]
      end
    end

    # Anything we thought was carried and can no longer be seen has gone into a
    # locker (or elsewhere). Its id is meaningless now; it keeps its history.
    # Only scrolls from a place we actually searched can be judged missing.
    if complete
      records.each do |r|
        next unless r[:status] == 'carried' && !claimed.include?(r[:uid])
        next unless r[:container] == 'hand' || searched.include?(r[:container])

        r[:status] = 'stored'
        r[:id] = nil
        r[:container] = 'stored'
        r[:stored_at] = now
      end
    end

    read_spells = read_scrolls(to_read.map { |scroll, _rec| scroll[:id] })
    to_read.each do |scroll, rec|
      spells = read_spells[scroll[:id]]
      if rec
        apply_reread(rec, spells)
      else
        register_new(scroll, spells, claimed, now)
      end
    end

    reconcile_with_invdb
    @dirty = true
    say 'some containers could not be inspected - stored/carried status may be out of date' unless complete
  end

  def self.apply_reread(rec, spells)
    return if spells.nil? # no answer; stays stale for next time

    if spells.empty?
      if rec[:unreadable]
        rec[:stale] = false
      else
        records.delete(rec) # every charge was used up
        say "#{rec[:name]} is spent - removed from the ledger"
      end
      return
    end

    rec[:spells] = spells
    rec[:unreadable] = false
    rec[:stale] = false
  end

  def self.register_new(scroll, spells, claimed, now)
    return if spells.nil?

    if spells.empty?
      add_record(scroll, [], now, unreadable: true)
      return
    end

    # Same name + same spells as a scroll we lost track of: it's that scroll,
    # back under a new id, so its use history carries over.
    twin = records.find do |r|
      r[:status] == 'stored' && !r[:unreadable] && !claimed.include?(r[:uid]) &&
        r[:name].to_s.casecmp?(scroll[:name]) && spell_nums(r[:spells]) == spell_nums(spells)
    end
    if twin
      claimed << twin[:uid]
      twin.merge!(id: scroll[:id], status: 'carried', container: scroll[:where], last_seen: now, stale: false, stored_at: nil)
      twin[:kind] = effective_kind(twin, scroll[:kind]) if scroll[:kind]
      twin[:spells] = spells
    else
      claimed << add_record(scroll, spells, now)[:uid]
    end
  end

  def self.add_record(scroll, spells, now, unreadable: false)
    rec = {
      uid: data[:next_uid], id: scroll[:id], name: scroll[:name], status: 'carried',
      container: scroll[:where], kind: scroll[:kind] || 'normal', spells: spells, used: {}, unreadable: unreadable,
      stale: false, first_seen: now, last_seen: now
    }
    data[:next_uid] += 1
    records << rec
    rec
  end

  ## ---- invoke tracking (hooks only observe; the main loop does the work) ----

  def self.install_hooks
    UpstreamHook.add(UPSTREAM_HOOK_ID, proc { |command| parse_upstream(command) })
    DownstreamHook.add(OBSERVER_HOOK_ID, proc { |line| observe_line(line) })
  end

  def self.remove_hooks
    UpstreamHook.remove(UPSTREAM_HOOK_ID)
    DownstreamHook.remove(OBSERVER_HOOK_ID)
    DownstreamHook.remove(CAPTURE_HOOK_ID)
  end

  # Runs on the input thread: remember which spell number is being invoked
  # (vibrant-ink invokes never name the spell in their reply) and swallow our
  # own ;commands.
  def self.parse_upstream(command)
    if (m = HOOK_CMD_RX.match(command))
      CMD_QUEUE.push(m[1])
      nil
    else
      if (m = INVOKE_CMD_RX.match(command.to_s.strip))
        @pending_invoke = [m[1].to_i, Time.now]
      end
      command
    end
  end

  # Runs on the socket thread - never blocks, never alters the line.
  def self.observe_line(line)
    return line unless line.include?('invoke') || line.include?('ink leaps') || line.include?('blank space')

    text = strip_tags(line)
    if (m = INVOKE_OK_RX.match(text))
      push_event(:ok, m[2])
    elsif VIBRANT_OK_RX.match?(text)
      push_event(:vibrant, nil)
    elsif (m = BLANK_RX.match(text))
      push_event(:blank, m[1])
    end
    line
  end

  def self.push_event(kind, spell_name)
    pending = @pending_invoke
    num = pending && (Time.now - pending[1]) < PENDING_TTL ? pending[0] : nil
    hands = [GameObj.right_hand, GameObj.left_hand].select { |o| scroll_obj?(o) }
                                                    .map { |o| { id: o.id.to_s, name: o.name.to_s } }
    EVENT_QUEUE.push({ kind: kind, spell_name: spell_name, num: num, hands: hands })
  end

  def self.drain_events
    handle_event(EVENT_QUEUE.pop) until EVENT_QUEUE.empty?
  end

  def self.handle_event(ev)
    held = ev[:hands].filter_map { |h| records.find { |r| r[:id] == h[:id] } }
    @unknown_invoke = true if held.empty? && !ev[:hands].empty?

    case ev[:kind]
    when :ok, :vibrant
      rec = held.find { |r| find_spell(r, ev[:num], ev[:spell_name]) } || (held.first if held.size == 1)
      spell = rec && find_spell(rec, ev[:num], ev[:spell_name])
      spell ||= rec[:spells].find { |s| s[:vibrant] } if rec && ev[:kind] == :vibrant && ev[:num].nil?
      num = spell&.dig(:num) || ev[:num] || (ev[:spell_name] && lookup_num(ev[:spell_name]))
      name = spell&.dig(:name) || ev[:spell_name]
      record_use(rec, num, name)
    when :blank
      rec = held.find { |r| find_spell(r, nil, ev[:spell_name]) }
      return unless rec

      rec[:spells].delete_if { |s| s[:name].to_s.casecmp?(ev[:spell_name]) }
      records.delete(rec) if rec[:spells].empty?
      @dirty = true
    end
  end

  def self.record_use(rec, num, name)
    k = key(num || name)
    entry = (usage[k] ||= { name: name.to_s, count: 0, last: 0 })
    entry[:name] = name.to_s if entry[:name].to_s.empty?
    entry[:count] += 1
    entry[:last] = Time.now.to_i
    if rec
      rec[:used] ||= {}
      rec[:used][k] = rec[:used].fetch(k, 0) + 1
      rec[:stale] = true # next refresh re-reads it: spent spells drop off
      # Once we've seen a scroll used it is no longer pristine, whatever bag it
      # goes back into. Held in memory only: it is forgotten when the script stops.
      @used_uids << rec[:uid]
      rec[:kind] = 'normal' if rec[:kind] == 'pristine'
    end
    @dirty = true
  end

  ## ---- output ----------------------------------------------------------------

  def self.live_records
    records.reject { |r| r[:unreadable] || r[:spells].empty? }
  end

  # Readable scrolls of the kinds ;scriv set show allows.
  def self.visible_records
    shown = shown_kinds
    live_records.select { |r| shown.include?(r[:kind] || 'normal') }
  end

  def self.scroll_label(group)
    n = group.size
    stored = group.count { |r| r[:status] == 'stored' }
    label = link(group.map { |r| r[:uid] }, paint(group.first[:kind] || 'normal', group.first[:name]))
    label << " x#{n}" if n > 1
    label << (n > 1 ? " (#{stored} stored)" : ' (stored)') if stored.positive?
    label
  end

  def self.show_summary(only = nil)
    t = proc { |s| Lich::Messaging.msg_format('thought', s, encode: false) }
    b = proc { |s| Lich::Messaging.msg_format('bold', s, encode: false) }

    by_spell = {}
    visible_records.each do |r|
      r[:spells].each do |s|
        next if only && !only.call(s)

        (by_spell[s[:num]] ||= { name: s[:name], vibrant: s[:vibrant], recs: [] })[:recs] << r
      end
    end

    carried = records.count { |r| r[:status] == 'carried' }
    stored  = records.count { |r| r[:status] == 'stored' }
    unread  = records.count { |r| r[:unreadable] }
    hidden = KINDS - shown_kinds
    _respond t.call("  Scroll Inventory v#{VERSION}  -  #{live_records.size} scroll(s): #{carried} carried, #{stored} stored" \
                    "#{hidden.empty? ? '' : "  (hiding #{hidden.join(', ')})"}")

    if by_spell.empty?
      _respond(only ? '  No scrolls on record hold that spell.' : '  No scroll spells on record. Run ;scriv to read your scrolls.')
      return
    end

    by_spell.sort.each do |num, info|
      groups = info[:recs].group_by { |r| [r[:name].downcase, r[:kind] || 'normal'] }.values
                          .sort_by { |g| [g.first[:name].downcase, KINDS.index(g.first[:kind] || 'normal')] }
      used = usage.dig(key(num), :count).to_i
      count = info[:recs].size
      tags = []
      tags << 'vibrant' if info[:vibrant]
      tags << "used #{used}" if used.positive?
      suffix = tags.empty? ? '' : "  [#{tags.join(', ')}]"
      _respond "  #{b.call("(#{num})")} #{info[:name]} #{count} #{count == 1 ? 'scroll' : 'scrolls'} - " \
               "#{groups.map { |g| scroll_label(g) }.join(', ')}#{suffix}"
      next unless only

      # A single-spell view also says where each of those scrolls is.
      info[:recs].sort_by { |r| [r[:name].downcase, r[:uid]] }.each do |r|
        where = r[:status] == 'carried' ? (r[:container] == 'hand' ? 'in hand' : "in #{r[:container]}") : 'stored'
        _respond "         #{link([r[:uid]], paint(r[:kind] || 'normal', r[:name]))}  (#{where}, ##{r[:uid]})"
      end
    end

    return if only

    total_used = usage.values.sum { |v| v[:count].to_i }
    foot = "  #{by_spell.size} spell(s), #{visible_records.size} scroll(s), #{total_used} use(s) tracked"
    foot += ", #{unread} unreadable/blank" if unread.positive?
    _respond t.call(foot)
    return unless @locker_unread&.positive?

    _respond t.call("  invdb sees #{@locker_unread} more scroll(s) in your lockers that haven't been read - " \
                    'take them out and run ;scriv to add them')
  end

  def self.show_detail
    t = proc { |s| Lich::Messaging.msg_format('thought', s, encode: false) }
    _respond t.call("  Scroll Inventory v#{VERSION}  -  #{records.size} tracked scroll(s)")
    records.sort_by { |r| [r[:status], r[:name].downcase, r[:uid]] }.each do |r|
      where = r[:status] == 'carried' ? "in #{r[:container]} (id #{r[:id]})" : 'stored'
      spells = if r[:unreadable]
                 'unreadable or blank'
               else
                 r[:spells].map do |s|
                   used = r.dig(:used, key(s[:num])).to_i
                   "#{s[:num]} #{s[:name]}#{s[:vibrant] ? ' [vibrant]' : ''}#{used.positive? ? " (used #{used})" : ''}"
                 end.join('; ')
               end
      _respond "  ##{r[:uid]}  #{paint(r[:kind] || 'normal', r[:name])}  [#{where}]  #{spells}"
    end
  end

  def self.show_help
    t = proc { |s| Lich::Messaging.msg_format('thought', s, encode: false) }
    b = proc { |s| Lich::Messaging.msg_format('bold', s, encode: false) }
    w = proc { |s| Lich::Messaging.msg_format('whisper', s, encode: true) }

    _respond t.call("  Scroll Inventory v#{VERSION}  -  Help Notes   (;scriv is the same as ;scrollinventory)")
    _respond ''
    _respond '  Keeps a ledger of your scrolls and the spells on them, and counts every invoke you make.'
    _respond '  It only reads and observes - it never invokes or casts anything.'
    _respond ''
    _respond b.call('  -- Usage --')
    _respond "  #{w.call(';scriv')}                 refresh (reads any new scrolls) and print the spell summary"
    _respond "  #{w.call(';scriv 1115')}            ONLY the scrolls holding that spell number"
    _respond "  #{w.call(';scriv setup')}           show setup options and their current values"
    _respond "  #{w.call(';scriv set pristine <bags>')}  bags of never-invoked scrolls   (shown teal, *name)"
    _respond "  #{w.call(';scriv set normal <bags>')}    bags of used scrolls           (shown plain)"
    _respond "  #{w.call(';scriv set infused <bags>')}   bags of sorcerer-infused scrolls (shown green, !name)"
    _respond "  #{w.call(';scriv set show pristine, normal, infused')}  choose which kinds ;scriv lists (any combination)"
    _respond "  #{w.call(';scriv list')}            print the last summary without touching the game"
    _respond "  #{w.call(';scriv detail')}          every tracked scroll, its spells, location and use counts"
    _respond "  #{w.call(';scriv spell 101')}       one spell (number or part of the name) and the scrolls holding it"
    _respond "  #{w.call(';scriv scan')}            re-read every scroll you carry, not only new ones"
    _respond "  #{w.call(';scriv forget <#>')}      drop one scroll from the ledger (# from detail)"
    _respond "  #{w.call(';scriv prune')}           drop all scrolls marked stored"
    _respond "  #{w.call(';scriv stop')}            stop the script (it stays running to track invokes)"
    _respond ''
    _respond '  Notes'
    _respond '  - Scroll names are links: click one to READ it. A name shared by several scrolls holding that'
    _respond '    spell (x2, x3...) reads each of them in turn. Stored scrolls must be taken out first.'
    _respond '  - Scrolls in lockers can only be read once you take them out; after that they are remembered'
    _respond '    by name + spell set and shown as "stored" until they turn up again under a new id.'
    _respond '  - Amounts are scrolls holding the spell (each is at least one cast). Per-spell charges are'
    _respond '    not visible to most professions, so "used" is what this script has watched you invoke.'
    _respond '  - Only top-level contents of your worn containers are searched.'
    _respond '  - Enhanced by ;invdb: run it now and then. With its database scriv searches only the bags that'
    _respond '    hold scrolls and retires scrolls that left your lockers. Without it, every bag is searched'
    _respond '    quietly in the background on each run. ;scriv scan always searches every bag.'
  end

  def self.show_setup
    t = proc { |s| Lich::Messaging.msg_format('thought', s, encode: false) }
    w = proc { |s| Lich::Messaging.msg_format('whisper', s, encode: true) }

    _respond t.call("  Scroll Inventory v#{VERSION}  -  Setup")
    _respond ''
    _respond "  Scroll bags - keep unused, used and infused scrolls apart and scriv will tell them apart:"
    { 'pristine' => 'never invoked  (shown teal, *name)', 'normal' => 'used / ordinary  (shown plain)',
      'infused' => 'sorcerer-infused  (shown green, !name)' }.each do |kind, blurb|
      names = kind_containers(kind)
      _respond "  #{kind.ljust(9)} #{names.empty? ? '(none)' : names.join(', ')}   - #{blurb}"
      _respond "     #{w.call(";scriv set #{kind} <bag>, <bag>")}"
    end
    _respond '  Bag names may carry an adjective (silver backpack). Give no names to clear a list.'
    _respond '  If no bags are named at all, every worn container is searched and all scrolls count as normal.'
    _respond ''
    _respond "  show        #{shown_kinds.join(', ')}"
    _respond "     #{w.call(';scriv set show pristine, normal, infused')}  which kinds ;scriv lists - any combination, any case"
    _respond ''
    if File.exist?(INVDB_PATH)
      _respond "  invdb       found - used to narrow the bag search and keep the stored list honest"
    else
      _respond "  invdb       not found - bags are searched quietly on every run (this script is enhanced by ;invdb)"
    end
  end

  def self.set_containers(kind, list)
    names = list.to_s.split(',').map(&:strip).reject(&:empty?)
    data[:settings][kind.to_sym] = names
    @dirty = true

    inv = GameObj.inv.to_a
    names.reject { |n| inv.any? { |i| name_match?(i, n) } }.each { |n| say "note: you aren't wearing anything matching \"#{n}\"" }

    all = configured_containers
    if all.empty?
      say "#{kind} list cleared - no bags named, so every worn container is searched"
      return
    end

    # Scrolls remembered in bags that are no longer searched can't be kept honest.
    hit_names = inv.select { |i| all.any? { |n| name_match?(i, n) } }.map { |i| i.name.to_s }
    unless hit_names.empty?
      records.reject! { |r| r[:status] == 'carried' && r[:container] != 'hand' && !hit_names.include?(r[:container]) }
    end
    say names.empty? ? "#{kind} list cleared" : "#{kind} bags: #{names.join(', ')}"
    say "searching only: #{all.join(', ')}"
  end

  def self.set_show(list)
    words = list.to_s.downcase.split(/[\s,]+/).reject(&:empty?)
    words = KINDS if words.empty? || words == ['all']
    bad = words - KINDS
    return say("unknown kind(s) #{bad.join(', ')} - choose from #{KINDS.join(', ')}") unless bad.empty?

    data[:settings][:show] = KINDS & words # canonical order, no repeats
    @dirty = true
    say "showing: #{shown_kinds.join(', ')}"
  end

  ## ---- commands --------------------------------------------------------------

  def self.drain_cmd_queue
    handle_command(CMD_QUEUE.pop) until CMD_QUEUE.empty?
  end

  def self.handle_command(msg)
    text = msg.to_s.strip

    case text
    when ''
      refresh
      show_summary
    when /\Ahelp\z/i
      show_help
    when /\Alist\z/i
      show_summary
    when /\Asetup\z/i
      show_setup
    when /\Aread\s+(\d[\d\s]*)\z/i
      read_linked($1)
    when /\Aset\s+(pristine|normal|infused)\b\s*(.*)\z/i
      set_containers($1.downcase, $2)
    when /\Aset\s+containers?\b\s*(.*)\z/i # 1.1.0 spelling: the used/ordinary list
      set_containers('normal', $1)
    when /\Aset\s+show\b\s*(.*)\z/i
      set_show($1)
    when /\Aset\b/i
      say 'nothing to set there - try ;scriv setup'
    when /\A\d{2,4}\z/
      refresh
      show_spell(text)
    when /\Adetail\z/i
      refresh
      show_detail
    when /\Ascan\z/i
      refresh(deep: true)
      show_summary
    when /\Aspell\s+(.+)\z/i
      refresh
      show_spell($1.strip)
    when /\Aforget\s+#?(\d+)\z/i
      forget($1.to_i)
    when /\Aprune\z/i
      prune
    when /\A(?:stop|quit|exit)\z/i
      say 'stopping.'
      exit
    else
      say "unknown command #{text.inspect} - try ;scriv help"
    end
  end

  def self.show_spell(query)
    matcher = if query =~ /\A\d+\z/
                ->(s) { s[:num] == query.to_i }
              else
                ->(s) { s[:name].to_s.downcase.include?(query.downcase) }
              end
    show_summary(matcher)
  end

  def self.forget(uid)
    rec = records.find { |r| r[:uid] == uid }
    return say("no scroll ##{uid} in the ledger") unless rec

    records.delete(rec)
    @dirty = true
    say "forgot ##{uid} (#{rec[:name]})"
  end

  def self.prune
    gone = records.select { |r| r[:status] == 'stored' }
    records.reject! { |r| r[:status] == 'stored' }
    @dirty = true
    say "pruned #{gone.size} stored scroll(s)"
  end

  def self.main_loop
    loop do
      begin
        drain_events
        drain_cmd_queue
        if @unknown_invoke
          @unknown_invoke = false
          say 'you invoked a scroll that is not in the ledger yet - run ;scriv to read it' if records.any?
        end
        if @dirty
          @dirty = false
          save_data!
        end
      rescue StandardError => e
        say "error in main loop: #{e.class}: #{e.message}"
      end
      pause 0.25
    end
  end
end

if Script.current.vars[1] =~ /\Ahelp\z/i
  ScrollInventory.show_help
  exit
end

ScrollInventory.install_hooks

before_dying do
  ScrollInventory.remove_hooks
  ScrollInventory.save_data!
end

ScrollInventory::CMD_QUEUE.push(Script.current.vars[1..-1].to_a.join(' '))
ScrollInventory.main_loop
