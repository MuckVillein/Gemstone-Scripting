# frozen_string_literal: true

require 'json'
require 'fileutils'
require 'set'

=begin

isharpie.lic (Item Sharpie) tags held items with a displayed note and/or a hidden note, then injects
that note inline wherever it appears in game text, or just in inventory (flag option).
Name your weapons and see the name in game!
Track your weapon and armor CER services in a hidden note, viewed through the list function!
List the enhancive benefits of your items right next to their name!


The following inputs are available:
  ;isharpie tag <noun> ["<note>"] [SN "<silent>"] [color ...]  - tag item in hand
  ;isharpie color <name>                 - set color on last tagged item
  ;isharpie delete <noun>                - remove note from item in hand (or ;isharpie d <noun>)
  ;isharpie list                         - list all stored notes
  ;isharpie colors                       - list valid color names
  ;isharpie help                         - command list

      author: Kyrandos
      Other scripts: Combatical, Merchantical, Loresang, VolnRestore2
      game: gs
      tags: items, inventory, notes, highlight, Sharpie
      version: 1.4.0
      required: Lich > 5.0

      \\Version\\
      1.0.0 07/01/2026 - initial release
      1.0.1 07/01/2026 - changed notes and fixed color name
      1.0.3 07/01/2026 - notes now saved to EduBarbarian\isharpie_name for persistence
      1.0.5 07/01/2026 - improved item detection: auto-bind on first sighting, word-set name matching
      1.0.6 07/01/2026 - sanity-check cached bindings against item name to prevent cross-item annotation
      1.0.7 07/01/2026 - silent notes (SN): per-item, list-only, no inline annotation
      1.0.8 07/01/2026 - trimmed help to one SN example with brief mention of variations
      1.1.0 07/02/2026 - startup Container search, silent mode added
      1.2.0 08/05/2026 - recall-based tagging with configurable loud/silent/both note modes
      1.3.0 08/07/2026 - Added mac compatibility
      1.3.1 08/08/2026 - fixed enchantment and ensorcelment parsing
      1.3.5 08/08/2026 - recall capture no longer uses reget - fixes tagged lines silently dropped from recall text
      1.3.6 08/08/2026 - sorcery now read from sanctify count instead of a dead "sorcery" keyword match; enchant/sorcery/ensorcel always render as one +XX/SX/EX group
      1.3.7 08/08/2026 - fixed CER adjective capture swallowing "is" for one-word adjectives, always falling back to "?"
      1.3.8 10/11/2026 - bare-noun notes no longer match every item with that noun; tags now survive locker manifests
      1.4.0 10/11/2026 - identical-item hardening: (Multiple Identical) marker, verify prompt on pickup (recall/analyze/look),
                         recall/contents fingerprints, re-identify tagged items at startup, rack put/remove tracking,
                         one id per note, ;isharpie why / fp / stale

=end

module ISharpie
  VERSION = '1.4.0'.freeze

  VALID_COLORS = %w[orange teal green yellow none].freeze
  DEFAULT_RECALL_MODE = 'loud'.freeze
  RECALL_MODE_ALIASES = {
    'loud note' => 'loud',
    'silent note' => 'silent',
    'both notes' => 'both',
    'loud' => 'loud',
    'silent' => 'silent',
    'both' => 'both',
    'sn' => 'silent',
    'bn' => 'both'
  }.freeze

  # GS4 crafting/quality descriptors that are legitimately dropped from worn or
  # display names. The word-set fallback only fires when the stored name is
  # longer than the stream name if every extra stored word is in this list --
  # prevents material adjectives like "starstone" from causing cross-item matches.
  WORD_SET_QUALIFIERS = %w[
    carved hammered turned twisted braided engraved etched inlaid stamped
    worked polished finished riveted studded forged fashioned wrought
    masterful flawless perfect exceptional excellent superb fine quality
    crude rough poor journeyman ordinary remarkable
    worn damaged battered dented cracked crumbling scratched
  ].to_set.freeze

  # Maps player-facing color names to Lich msg_format preset names.
  COLOR_MAP = {
    'orange' => 'thought',
    'teal'   => 'whisper',
    'green'  => 'speech',
    'yellow' => 'bold',
    'none'   => 'none'
  }.freeze


  # <a exist="ID" noun="NOUN">TAG_TEXT</a> plus an optional trailing
  # plain-text clause, up to the next tag or a punctuation boundary that
  # marks the end of this item's own description (sentence punctuation, a
  # list comma, or a "(2)"-style stack-count suffix). Matches anywhere in the
  # downstream stream - flat per-item dumps, the categorized inventory
  # block, room text, and "You put/remove" sentences all share this shape
  # (confirmed against real .xml logs).
  ITEM_TAG_RX = /<a exist="(-?\d+)" noun="([^"]*)">([^<]*)<\/a>([^<.,:;!?(]*)/.freeze

  # "You put X in|on (a|an|the|your) Y." - deposit into a named container.
  # Locker weapon racks use "on" ("You put a dagger on a weapon rack.").
  PUT_RX = /You put (.+?) (?:in|on|under|behind) (?:a|an|the|your) (.+?)\./.freeze

  # "You remove X from in|on (a|an|the|your) Y." - "from in"/"from on" is the
  # distinguishing substring; plain "from your belt"-style removals (no
  # container involved) never match this, by design.
  REMOVE_RX = /You remove (.+?) from (?:in|on|under|behind) (?:a|an|the|your) (.+?)\./.freeze

  # One entry of a server-side container listing:
  #   <inv id='CONTAINER'> a <a exist="ID" noun="NOUN">TAG_TEXT</a></inv>
  # Sent after <clearContainer id="CONTAINER"/> whenever a container's
  # contents are refreshed - including the remaining contents of the source
  # container on a "You remove" line (confirmed against real .xml logs). The
  # "In the <a ...>wardrobe</a>:" header entry never matches (no article).
  # Container ids are usually numeric, but the stow container is sent as
  # id="stow".
  INV_LIST_RX        = /<inv id='([^']+)'>\s*(?:an?|some|the)?\s*<a exist="(\d+)" noun="[^"]*">([^<]*)<\/a>/.freeze
  CLEAR_CONTAINER_RX = /<clearContainer id="([^"]+)"\/>/.freeze

  # Categorized inventory views collapse identical items into one tag with a
  # count: "a <a ...>slender iron rapier</a> (2)".
  STACK_COUNT_RX = /\A\s*\((\d+)\)/.freeze

  # Locker manifests list only the player's own items, under exist ids that
  # are regenerated every time the locker is opened or a manifest is read.
  MANIFEST_START_RX  = /you (?:see|recall) the contents of your (.+?):/i.freeze
  MANIFEST_END_RX    = /Obvious items:|There are no items in this/i.freeze
  MANIFEST_TIMEOUT   = 15
  MANIFEST_MAX_LINES = 3000

  # Locations that mean "somewhere on the character" without naming a
  # specific container. Notes created before container tracking default here.
  ON_PERSON = %w[carried worn].freeze

  AMBIGUOUS_TEXT = 'Multiple Identical - at least one tagged'.freeze

  # Two container fingerprints count as the same container when at least this
  # share of items overlaps - contents drift as items are added and removed.
  CONTENTS_MATCH_RATIO = 0.75

  ANNOTATOR_HOOK_ID          = 'isharpie_annotator'.freeze
  CONTAINER_TRACKER_HOOK_ID  = 'isharpie_container_tracker'.freeze
  UPSTREAM_HOOK_ID           = 'isharpie_upstream'.freeze
  RECALL_CAPTURE_HOOK_ID     = 'isharpie_recall_capture'.freeze
  # $lich_char_regex (','|';') because Lich uses ',' as the script-trigger
  # character on the Genie frontend (the mac-compatible client) instead of
  # ';' - hardcoding ';' here left Genie/mac players unable to reach this
  # hook at all.
  HOOK_CMD_RX = /^(?:<c>)?#{$lich_char_regex}#{Regexp.escape(Script.current.name)}(?:\s+(.*))?$/i
  EDUBARBARIAN_DIR = File.join(LICH_DIR, 'EduBarbarian').freeze

  CMD_QUEUE     = Queue.new
  CONFIRM_QUEUE = Queue.new

  @exist_bindings       = {}
  @pending_confirmation = nil
  @last_touched_note_id = nil
  @last_ambiguous_list  = nil
  @note_counter         = nil
  @startup_suppress     = false
  @inventory_only       = false
  @recall_mode          = nil
  @manifest_buffer      = nil
  @manifest_started     = nil
  @manifest_where       = nil
  @dirty                = false

  ## ---- persisted notes ---------------------------------------------------

  def self.notes_path
    char = XMLData.name.to_s.downcase.gsub(/[^a-z0-9]+/, '_').gsub(/\A_+|_+\z/, '')
    File.join(EDUBARBARIAN_DIR, "isharpie_#{char}.json")
  end

  def self.normalize_recall_mode(value)
    raw = value.to_s.strip.downcase
    return DEFAULT_RECALL_MODE if raw.empty?

    RECALL_MODE_ALIASES[raw] || RECALL_MODE_ALIASES[raw.gsub(/\s+/, ' ')] || DEFAULT_RECALL_MODE
  end

  def self.load_state
    path = notes_path
    if File.exist?(path)
      data = JSON.parse(File.read(path), symbolize_names: true)
      if data.is_a?(Array)
        state = { notes: data, inventory_only: false, recall_mode: DEFAULT_RECALL_MODE }
      else
        state = {
          notes: Array(data[:notes]),
          inventory_only: data[:inventory_only] || false,
          recall_mode: normalize_recall_mode(data[:recall_mode] || DEFAULT_RECALL_MODE)
        }
      end
    else
      state = { notes: [], inventory_only: false, recall_mode: DEFAULT_RECALL_MODE }
    end

    @inventory_only = state[:inventory_only]
    @recall_mode = state[:recall_mode]
    state
  rescue StandardError => e
    say "could not load notes from #{notes_path}: #{e.class}"
    { notes: [], inventory_only: false, recall_mode: DEFAULT_RECALL_MODE }
  end

  def self.notes
    @notes ||= load_state[:notes]
  end

  def self.recall_mode
    @recall_mode ||= load_state[:recall_mode]
  end

  def self.save_notes!
    FileUtils.mkdir_p(EDUBARBARIAN_DIR)
    File.write(notes_path, JSON.pretty_generate({
      notes: @notes || notes,
      inventory_only: @inventory_only,
      recall_mode: recall_mode
    }))
  rescue StandardError => e
    say "could not save notes to #{notes_path}: #{e.class}"
  end

  def self.toggle_inventory_only
    notes  # ensure loaded before toggling
    @inventory_only = !@inventory_only
    save_notes!
    state = @inventory_only ? 'ON  - notes only appear on items in your own inventory' \
                            : 'OFF - notes appear everywhere a matching item name is seen'
    say "inventory-only: #{state}"
  end

  def self.set_recall_mode(mode)
    normalized = normalize_recall_mode(mode)
    return say("unknown recall mode #{mode.inspect} - try loud, silent, or both") unless %w[loud silent both].include?(normalized)

    @recall_mode = normalized
    save_notes!
    say "recall mode: #{normalized}"
  end

  def self.next_note_id
    @note_counter ||= notes.map { |n| n[:id].to_s.sub(/^n/, '').to_i }.max.to_i
    @note_counter += 1
    "n#{@note_counter}"
  end

  def self.add_note(long_name:, container:, note:, color:, silent_note: nil)
    record = {
      id: next_note_id,
      long_name: long_name,
      container: container,
      note: note,
      silent_note: silent_note,
      color: color,
      created_at: Time.now.to_i
    }
    notes.push(record)
    save_notes!
    record
  end

  def self.update_note(id, **changes)
    record = notes.find { |n| n[:id] == id }
    return nil unless record

    changes.each { |k, v| record[k] = v }
    save_notes!
    record
  end

  def self.remove_note(id)
    removed = notes.reject! { |n| n[:id] == id }
    save_notes! if removed
    !!removed
  end

  def self.candidates_for(long_name, container_context = nil)
    matches = notes.select { |n| n[:long_name] == long_name }

    # Suffix-match fallback: GS4 prepends quality/condition descriptors (e.g.
    # "masterful") in display output but omits them from hand-tag updates, so
    # GameObj.right_hand.name at tag-time may be shorter than what the stream
    # shows. If no exact match, accept any stored name that is a trailing
    # suffix of the stream name.
    # Stored names that are a single bare noun ("sack") are excluded: they would
    # match every other item sharing that noun ("small burlap sack").
    if matches.empty?
      matches = notes.select { |n|
        n[:long_name].split.length >= 2 &&
          n[:long_name].length < long_name.length && long_name.end_with?(n[:long_name])
      }
    end

    # Word-set fallback: GS4 sometimes omits descriptors from worn/display names
    # that were present when held (e.g. "haon antlers" worn vs "haon-carved antlers"
    # held). If still no match, accept any stored name where every word from the
    # shorter name appears in the longer name. Requires at least 2 words to avoid
    # single-noun false positives.
    if matches.empty?
      stream_words = long_name.downcase.gsub(/[^a-z0-9\s]/, ' ').split
      stream_noun  = stream_words.last
      matches = notes.select { |n|
        stored_words = n[:long_name].downcase.gsub(/[^a-z0-9\s]/, ' ').split
        next false unless stored_words.last == stream_noun
        # Explicit length comparison avoids minmax_by's equal-length tie-break
        # bug where both results point to the same (first) array, causing the
        # check to compare the stream against itself and always pass.
        short, long_w = stream_words.length <= stored_words.length \
                          ? [stream_words, stored_words] \
                          : [stored_words, stream_words]
        # When the stored name is longer, extra stored words must be known
        # crafting/quality qualifiers -- blocks "white band" from matching
        # "white starstone band" because "starstone" is not a qualifier.
        if stored_words.length > stream_words.length
          extra = stored_words - stream_words
          next false unless extra.all? { |w| WORD_SET_QUALIFIERS.include?(w) }
        end
        short.length >= 2 && short.all? { |w| long_w.include?(w) }
      }
    end

    return matches if container_context.nil?

    narrowed = matches.select { |n| n[:container] == container_context }
    narrowed.any? ? narrowed : matches
  end

  def self.normalize_container_name(raw)
    raw.to_s.sub(/^(?:a|an|the|your)\s+/i, '').strip
  end

  ## ---- session-only exist-id cache ----------------------------------------
  # Never read from or written to CharSettings - always starts empty every
  # script run, on purpose, since exist ids don't survive a login.

  def self.exist_bound?(exist_id)
    @exist_bindings.key?(exist_id)
  end

  def self.bound_note_for(exist_id)
    note_id = @exist_bindings[exist_id]
    return nil unless note_id

    notes.find { |n| n[:id] == note_id }
  end

  # A note is bound to at most one exist id at a time. Ids regenerate on
  # login and on every locker open, so a fresh id for the same note replaces
  # the stale one; callers check bound_elsewhere_on_person? first to stop a
  # genuine identical twin from stealing the binding.
  def self.bind!(exist_id, note_id, where: nil)
    exist_id = exist_id.to_s
    @exist_bindings.delete_if { |eid, nid| nid == note_id && eid != exist_id }
    @exist_bindings[exist_id] = note_id
    mark_seen(note_id, where || (carried_id?(exist_id) ? 'carried' : nil))
  end

  def self.bound_elsewhere_on_person?(note_id, exist_id, entries = carried_entries)
    ids = entries.map { |o, _| o.id.to_s }
    @exist_bindings.any? { |eid, nid| nid == note_id && eid != exist_id.to_s && ids.include?(eid) }
  end

  # Persisted lazily (main_loop flushes) - this runs on the socket thread.
  def self.mark_seen(note_id, where = nil)
    record = notes.find { |n| n[:id] == note_id }
    return unless record

    record[:last_seen] = Time.now.to_i
    record[:last_seen_where] = where if where
    @dirty = true
  end

  ## ---- what the character is carrying -----------------------------------

  def self.held_objects
    [GameObj.right_hand, GameObj.left_hand].compact.select { |g| g.id && g.name && g.name != 'Empty' }
  end

  # [[GameObj, location]] for everything on the character. location is
  # 'carried' for hands, 'worn' for top-level inventory, otherwise the
  # normalized name of the container holding it - the same form the put/remove
  # tracker stores in a note's :container.
  def self.carried_entries
    entries = held_objects.map { |o| [o, 'carried'] }
    walk = lambda do |items, location|
      items.each do |i|
        entries << [i, location]
        walk.call(i.contents.to_a, normalize_container_name(long_name_for(i)))
      end
    end
    walk.call(GameObj.inv.to_a, 'worn')
    entries
  end

  def self.carried_id?(exist_id)
    id = exist_id.to_s
    carried_entries.any? { |o, _| o.id.to_s == id }
  end

  def self.on_person_names(entries)
    ON_PERSON + entries.map { |o, _| normalize_container_name(long_name_for(o)) }
  end

  # Identical items share the exact same <a> tag text. Hands report a
  # shortened name ("iron rapier" for "slender iron rapier"), so a multi-word
  # trailing match also counts; a bare noun never does.
  def self.same_item_name?(a, b)
    a = a.to_s.strip.downcase
    b = b.to_s.strip.downcase
    return false if a.empty? || b.empty?
    return true if a == b

    short, long = [a, b].sort_by(&:length)
    short.split.length >= 2 && long.end_with?(" #{short}")
  end

  # Returns true if the given exist_id is found anywhere in the player's own
  # inventory (hands, worn, carried, or inside containers they own). Used to
  # guard auto-binding: we only label items we can confirm belong to us, so
  # other players' items with the same name are silently skipped.
  def self.player_item?(exist_id)
    id = exist_id.to_s
    return true if GameObj.right_hand&.id == id
    return true if GameObj.left_hand&.id == id
    inv_contains_id?(GameObj.inv.to_a, id)
  end

  def self.inv_contains_id?(items, id)
    items.any? { |item|
      item.id == id || inv_contains_id?(item.contents.to_a, id)
    }
  end

  # At script startup, look in every top-level inventory item to populate
  # GameObj with nested container contents. Output is suppressed via
  # @startup_suppress so nothing shows to the player; Lich's XML parser still
  # runs underneath and fills in item.contents for each container.
  # Non-containers get a "can't look in that" response which is also suppressed.
  def self.preload_containers
    @startup_suppress = true
    silence_me  # toggles script.silent = true, suppresses [script]>command echo
    begin
      say 'examining inventory...'
      noun_counts = Hash.new(0)
      GameObj.inv.to_a.each do |item|
        next if item.contents  # already populated this session, skip
        noun_counts[item.noun] += 1
        n       = noun_counts[item.noun]
        ordinal = n == 1 ? '' : "#{n}#{n == 2 ? 'nd' : n == 3 ? 'rd' : 'th'} "
        fput "look in #{ordinal}my #{item.noun}"
      end
      say 'done!'
    rescue => e
      say "preload warning: #{e.message}"
    ensure
      silence_me  # toggles back to false
      @startup_suppress = false
    end
  end

  ## ---- name helpers --------------------------------------------------------

  # Tag text plus trailing clause only - deliberately never before_name/
  # full_name, so this matches exactly what the regex-based hooks below can
  # reliably extract from raw text (a leading clause like "a sinew-woven" is
  # not safely regex-able without the structured tree GameObj itself uses).
  # Both this and the hooks' own extraction must compute long_name the same
  # way, or matching silently breaks.
  def self.long_name_for(gameobj)
    [gameobj.name, gameobj.after_name].compact.reject(&:empty?).join(' ').strip
  end

  # A bare trailing clause that actually starts a new sentence clause (most
  # commonly "from in your <container>" off the back of a removal sentence)
  # is sentence structure, not part of the item's own description - real
  # descriptive clauses ("accented with a diamond", "filed with gravel")
  # never start this way.
  def self.sanitize_trailing(trailing)
    t = trailing.to_s
    return '' if t.strip =~ /^(?:from|to|in|at)\b/i

    t
  end

  def self.extract_tagged(span)
    m = ITEM_TAG_RX.match(span.to_s)
    return nil unless m

    exist_id, _noun, tag_text, trailing = m[1], m[2], m[3], m[4]
    long_name = "#{tag_text}#{sanitize_trailing(trailing)}".strip
    return nil if long_name.empty?

    { exist_id: exist_id, long_name: long_name, tag_text: tag_text.strip }
  end

  def self.extract_container_name(span)
    tagged = extract_tagged(span)
    return normalize_container_name(tagged[:long_name]) if tagged

    normalize_container_name(span)
  end

  ## ---- display formatting --------------------------------------------------

  def self.format_annotation(note_record, confirmed:)
    visible = note_record[:note].to_s.strip
    return nil if visible.empty?
    text = "(#{visible}#{confirmed ? '' : '?'})"
    color = note_record[:color] || 'none'
    return text if color == 'none'

    Lich::Messaging.msg_format(COLOR_MAP[color] || color, text, encode: true)
  end

  # Shown on every copy when identical items are in view and we can't tell
  # which one carries the note - never the note text itself, which would put
  # a confident tag on what may be the wrong item.
  def self.format_ambiguous(note_records)
    text  = "(#{AMBIGUOUS_TEXT})"
    color = note_records.map { |n| n[:color] }.find { |c| c && c != 'none' } || 'none'
    return text if color == 'none'

    Lich::Messaging.msg_format(COLOR_MAP[color] || color, text, encode: true)
  end

  def self.label_for(note_record)
    visible = note_record[:note].to_s.strip
    silent  = note_record[:silent_note].to_s.strip
    return visible unless visible.empty?

    silent.empty? ? note_record[:id].to_s : "SN: #{silent}"
  end

  ## ---- identity resolution ------------------------------------------------------
  # Exist ids regenerate on login and on every locker open, so an unbound item
  # is identified by name, by what identical items are in view, and by the
  # container its note was last tracked in.

  # Name match with the trailing-clause retry: a trailing clause ("with a
  # rippling green sheen...") is narrative description, not identity.
  def self.name_candidates(long_name, tag_text)
    candidates = candidates_for(long_name)
    tag = tag_text.to_s.strip
    candidates = candidates_for(tag) if candidates.empty? && !tag.empty? && tag != long_name
    candidates
  end

  # tag text (downcased) => Set of exist ids appearing in a line or block.
  def self.context_ids(text)
    ctx = Hash.new { |h, k| h[k] = Set.new }
    text.to_s.scan(ITEM_TAG_RX) { |eid, _noun, tag, _trailing| ctx[tag.strip.downcase] << eid }
    ctx
  end

  # Exist ids of other items identical to this one that are in view: in the
  # same line/block (e.g. a container listing or a manifest), on the
  # character, or in the source container's current contents.
  def self.twin_ids(exist_id, tag_text, context, entries, container_id: nil)
    ids = Set.new
    context&.each { |tag, eids| ids.merge(eids) if same_item_name?(tag, tag_text) }
    entries.each { |o, _| ids << o.id.to_s if same_item_name?(o.name, tag_text) }
    if container_id
      Array(GameObj.containers[container_id.to_s]).each { |o| ids << o.id.to_s if same_item_name?(o.name, tag_text) }
    end
    ids.delete(exist_id.to_s)
    ids
  end

  # Does the item's location fit where its note was last tracked?
  #   location - container name, 'carried', :manifest, or nil (unknown)
  def self.container_agrees?(note_container, location, person_names)
    nc = note_container.to_s
    return true if nc.empty? || ON_PERSON.include?(nc) || location.nil?
    return true if nc == location
    # A manifest can't be checked against a locker container name, but a note
    # last tracked into a container on the character points away from it.
    return !person_names.include?(nc) if location == :manifest
    return person_names.include?(nc) if person_names.include?(location)

    false
  end

  # Decides what an unbound item is:
  #   [:bind, note]       - one note fits and no unidentified twin is in view
  #   [:maybe, note]      - one note fits by name, but it was last tracked elsewhere
  #   [:twin, note]       - identical to a tagged item already identified on the
  #                         character, so this one is an untagged copy
  #   [:ambiguous, notes] - identical items in view; can't tell which is tagged
  #   [:none]             - no note matches this name
  def self.resolve(exist_id, tag_text, long_name, context, location:, container_id: nil, stacked: false)
    candidates = name_candidates(long_name, tag_text)
    return [:none] if candidates.empty?
    # One tag standing for several identical items can't be pinned to any.
    return [:ambiguous, candidates] if stacked

    entries = carried_entries
    live = candidates.select { |c| bound_elsewhere_on_person?(c[:id], exist_id, entries) }
    return [:twin, live.first] if live.size == candidates.size

    unresolved = candidates - live
    # Twins already bound to a note are accounted for; only unidentified
    # copies make this item ambiguous.
    twins = twin_ids(exist_id, tag_text, context, entries, container_id: container_id)
            .reject { |eid| @exist_bindings.key?(eid) }
    return [:ambiguous, unresolved] unless unresolved.size == 1 && twins.empty?

    note = unresolved.first
    agrees = container_agrees?(note[:container], location, on_person_names(entries))
    [agrees ? :bind : :maybe, note]
  end

  ## ---- annotator downstream hook --------------------------------------------
  # Runs on the socket-reading thread - must never block on game I/O.

  def self.install_annotator
    DownstreamHook.add(ANNOTATOR_HOOK_ID, proc { |line| annotate_line(line) })
  end

  def self.remove_annotator
    DownstreamHook.remove(ANNOTATOR_HOOK_ID)
  end

  # A locker manifest arrives one item per line, so a duplicate further down
  # can't be known while annotating the first copy. The whole manifest is
  # held back and annotated as one block once its end marker arrives. Its
  # items are trusted as the player's own even though their regenerated ids
  # are not in GameObj.inv. Flushed early on timeout or size cap so a missed
  # end marker can never swallow output for long.
  def self.annotate_line(line)
    return nil if @startup_suppress

    if @manifest_buffer
      @manifest_buffer << line
      expired = Time.now.to_f - @manifest_started > MANIFEST_TIMEOUT ||
                @manifest_buffer.size > MANIFEST_MAX_LINES
      return nil unless line =~ MANIFEST_END_RX || expired

      block = @manifest_buffer
      @manifest_buffer = nil
      return annotate_block(block, manifest: true)
    end

    if (m = MANIFEST_START_RX.match(line))
      @manifest_where   = m[1].strip
      @manifest_buffer  = [line]
      @manifest_started = Time.now.to_f
      return nil
    end

    annotate_block([line], manifest: false)
  end

  def self.annotate_block(lines, manifest:)
    text = lines.join
    return text unless text.include?('<a ')
    return text if notes.empty?

    context = context_ids(text)
    lines.map { |l| annotate_one(l, context, manifest) }.join
  rescue StandardError => e
    say "annotator error: #{e.class}: #{e.message}"
    lines.join
  end

  def self.annotate_one(line, context, manifest)
    return line unless line.include?('<a ')

    line.gsub(ITEM_TAG_RX) do |whole_match|
      exist_id, _noun, tag_text, trailing = $1, $2, $3, $4
      post_match = $~.post_match
      next whole_match if exist_id.to_i < 0
      long_name = "#{tag_text}#{sanitize_trailing(trailing)}".strip
      next whole_match if long_name.empty?

      tag_only = whole_match[0, whole_match.length - trailing.length]
      stacked  = post_match[STACK_COUNT_RX, 1].to_i >= 2

      if exist_bound?(exist_id) && stacked
        note = bound_note_for(exist_id)
        ann = note && format_ambiguous([note])
        ann ? (tag_only + ann + trailing) : whole_match
      elsif exist_bound?(exist_id)
        if @inventory_only
          id = exist_id.to_s
          # Items in hand appear in combat/action text - suppress those.
          # Items in inventory/containers (not held) are safe to annotate.
          in_hand = GameObj.right_hand&.id == id || GameObj.left_hand&.id == id
          next whole_match if in_hand || !inv_contains_id?(GameObj.inv.to_a, id)
        end
        note = bound_note_for(exist_id)
        if note
          # Sanity check: verify the displayed name is still plausible for this
          # note before trusting the cached binding. Exist IDs can collide on
          # test servers (recycled IDs) or change after locker storage, causing
          # a stale binding to incorrectly annotate a completely different item.
          check_names = [long_name, tag_text.strip].uniq
          plausible = check_names.any? { |n| candidates_for(n).any? { |c| c[:id] == note[:id] } }
          if plausible
            ann = format_annotation(note, confirmed: true)
            ann ? (tag_only + ann + trailing) : whole_match
          else
            @exist_bindings.delete(exist_id)
            whole_match
          end
        else
          whole_match
        end
      else
        # Only attempt to match/bind items that are in the player's own
        # inventory (or a manifest of it). Skips other players' items that
        # share a name with a tagged item (e.g. Folwer's backpack).
        next whole_match unless manifest || player_item?(exist_id)

        location = if manifest
                     :manifest
                   else
                     entry = carried_entries.find { |o, _| o.id.to_s == exist_id.to_s }
                     entry ? entry[1] : 'carried'
                   end
        kind, result = resolve(exist_id, tag_text.strip, long_name, context, location: location, stacked: stacked)
        ann = case kind
              when :bind
                bind!(exist_id, result[:id], where: manifest ? @manifest_where : nil)
                format_annotation(result, confirmed: true)
              when :maybe
                format_annotation(result, confirmed: false)
              when :ambiguous
                format_ambiguous(result)
              end
        ann ? (tag_only + ann + trailing) : whole_match
      end
    end
  end

  ## ---- container tracker downstream hook ------------------------------------
  # Pure observation - always returns the input string unchanged. Also runs
  # on the socket-reading thread.

  def self.install_container_tracker
    DownstreamHook.add(CONTAINER_TRACKER_HOOK_ID, proc { |line|
      handle_container_line(line)
      line
    })
  end

  def self.remove_container_tracker
    DownstreamHook.remove(CONTAINER_TRACKER_HOOK_ID)
  end

  def self.handle_container_line(line)
    refresh_contents_fingerprints(line)
    return unless line.include?('You put') || line.include?('You remove')

    if (m = PUT_RX.match(line))
      item = extract_tagged(m[1])
      return unless item

      handle_deposit(item[:exist_id], extract_container_name(m[2]))
    elsif (m = REMOVE_RX.match(line))
      item = extract_tagged(m[1])
      return unless item

      source = extract_tagged(m[2])
      handle_withdrawal(item, extract_container_name(m[2]), source && source[:exist_id], context_ids(line))
    end
  rescue StandardError => e
    say "container tracker error: #{e.class}: #{e.message}"
  end

  # Keeps a tagged container's contents fingerprint current: whenever the
  # server sends a full refresh of a bound container's contents, store it.
  def self.refresh_contents_fingerprints(line)
    return unless line.include?('clearContainer')

    line.scan(CLEAR_CONTAINER_RX).flatten.uniq.each do |cid|
      note = bound_note_for(cid)
      next unless note

      names = line.scan(INV_LIST_RX).select { |c, _e, _t| c == cid }.map { |_c, _e, t| t.strip.downcase }.sort
      next if note[:contents_fp] == names

      note[:contents_fp] = names
      @dirty = true
    end
  end

  # Only a bound item updates its note's container - an unidentified
  # identical copy being put away must not overwrite where the tagged one is.
  def self.handle_deposit(exist_id, container)
    note = bound_note_for(exist_id)
    return unless note

    update_note(note[:id], container: container)
    mark_seen(note[:id], container)
  end

  def self.handle_withdrawal(item, container, container_id, context)
    exist_id = item[:exist_id]
    if (note = bound_note_for(exist_id))
      update_note(note[:id], container: 'carried')
      mark_seen(note[:id], 'carried')
      return
    end

    kind, result = resolve(exist_id, item[:tag_text], item[:long_name], context,
                           location: container, container_id: container_id)
    case kind
    when :bind
      bind!(exist_id, result[:id], where: 'carried')
      update_note(result[:id], container: 'carried')
    when :twin
      CONFIRM_QUEUE.push({ notice: "#{item[:long_name]} is identical to your tagged \"#{label_for(result)}\" " \
                                   "(already identified) - this one is untagged" })
    when :maybe
      CONFIRM_QUEUE.push({ exist_id: exist_id, name: item[:long_name], candidates: [result], ambiguous: false })
    when :ambiguous
      # Container evidence: the note was last put into exactly this
      # container, and no identical copy is left in it.
      in_container = result.select { |n| n[:container] == container }
      same_container_twins = Set.new(context.select { |tag, _| same_item_name?(tag, item[:tag_text]) }.values.flat_map(&:to_a))
      Array(GameObj.containers[container_id.to_s]).each do |o|
        same_container_twins << o.id.to_s if same_item_name?(o.name, item[:tag_text])
      end if container_id
      same_container_twins.delete(exist_id)
      if in_container.size == 1 && same_container_twins.empty? && !ON_PERSON.include?(container)
        bind!(exist_id, in_container.first[:id], where: 'carried')
        update_note(in_container.first[:id], container: 'carried')
        CONFIRM_QUEUE.push({ notice: "matched #{item[:long_name]} to \"#{label_for(in_container.first)}\" by its container" })
        return
      end

      # Contents evidence, if this item's contents are already known.
      known = known_contents(exist_id)
      by_contents = result.select { |n| contents_match?(n[:contents_fp], known) }
      if by_contents.size == 1
        bind!(exist_id, by_contents.first[:id], where: 'carried')
        update_note(by_contents.first[:id], container: 'carried')
        CONFIRM_QUEUE.push({ notice: "matched #{item[:long_name]} to \"#{label_for(by_contents.first)}\" by its contents" })
        return
      end

      CONFIRM_QUEUE.push({ exist_id: exist_id, name: item[:long_name], candidates: result, ambiguous: true })
    end
  end

  ## ---- fingerprints ------------------------------------------------------------

  def self.known_contents(exist_id)
    known = GameObj.containers[exist_id.to_s]
    known&.map { |o| o.name.to_s.strip.downcase }&.sort
  end

  # Contents drift as items come and go, so this is an overlap test rather
  # than equality. Two empty containers prove nothing either way.
  def self.contents_match?(stored, found)
    return false if stored.nil? || found.nil? || (stored.empty? && found.empty?)

    pool = found.dup
    overlap = stored.count { |name| (i = pool.index(name)) && pool.delete_at(i) }
    overlap.to_f / [stored.size, found.size].max >= CONTENTS_MATCH_RATIO
  end

  def self.capture_command(cmd, wait = 0.8)
    captured = []
    DownstreamHook.add(RECALL_CAPTURE_HOOK_ID, proc { |line| captured << line; line })
    begin
      fput cmd
      waitrt?
      pause wait
    ensure
      DownstreamHook.remove(RECALL_CAPTURE_HOOK_ID)
    end
    captured.join("\n")
  end

  # Sorted, downcased tag texts inside a container; [] when empty, nil when
  # it can't be looked in.
  def self.look_in_contents(exist_id)
    text  = capture_command("look in ##{exist_id}", 0.5)
    names = text.scan(INV_LIST_RX).select { |c, _e, _t| c == exist_id.to_s }.map { |_c, _e, t| t.strip.downcase }
    return names.sort unless names.empty?
    return [] if text =~ /There is nothing in/i

    known_contents(exist_id)
  end

  def self.contents_fingerprint(item)
    known = known_contents(item.id)
    return known if known
    return nil unless item.type.to_s.include?('container')

    look_in_contents(item.id)
  rescue StandardError
    nil
  end

  ## ---- confirmation flow ----------------------------------------------------
  # Driven from main_loop (our own thread), never from the hooks directly.

  def self.pending_confirmation
    @pending_confirmation
  end

  def self.drain_confirm_queue
    until CONFIRM_QUEUE.empty?
      req = CONFIRM_QUEUE.pop
      if req[:notice]
        say req[:notice]
      else
        start_confirmation(req)
      end
    end
  end

  def self.start_confirmation(req)
    say "dropping an earlier unanswered confirmation to ask about a new one" if @pending_confirmation

    @pending_confirmation = req.merge(index: 0)
    ask_current_candidate
  end

  def self.ask_current_candidate
    pc = @pending_confirmation
    return unless pc

    candidate = pc[:candidates][pc[:index]]
    unless candidate
      say "no more candidates - #{pc[:name] || 'that item'} stays untagged"
      @pending_confirmation = nil
      return
    end

    if pc[:ambiguous]
      say "you picked up #{pc[:name]} - you own identical ones and at least one is tagged \"#{label_for(candidate)}\""
    else
      where = candidate[:container].to_s
      say "is this the one noted \"#{label_for(candidate)}\"?#{where.empty? ? '' : " (last tracked in: #{where})"}"
    end
    say 'verify with ;isharpie verify recall | verify analyze | verify look  -  then ;isharpie yes (this is it) / ;isharpie no'
  end

  # Runs a game verb against the pending item and compares the result with
  # what was stored when it was tagged. A clear match confirms automatically.
  def self.verify_pending(kind)
    pc = @pending_confirmation
    return say('nothing to verify - no confirmation is pending') unless pc

    candidate = pc[:candidates][pc[:index]]
    target = "##{pc[:exist_id]}"

    case kind.downcase
    when 'recall'
      summary = summarize_recall(capture_command("recall #{target}").gsub(/<[^>]+>/, '')).to_s
      stored  = candidate[:recall_fp].to_s
      if stored.empty?
        say "recall: #{summary.empty? ? 'nothing useful' : summary} - no stored recall to compare (note: \"#{label_for(candidate)}\")"
      elsif summary == stored
        say 'recall matches the tagged item'
        answer_confirmation(true)
      else
        say "recall differs - tagged item: #{stored} / this item: #{summary.empty? ? 'nothing useful' : summary}"
      end
    when 'look'
      found  = look_in_contents(pc[:exist_id])
      stored = candidate[:contents_fp]
      if found.nil?
        say "couldn't see inside it"
      elsif stored.nil?
        say "it holds #{found.size} item(s) - no stored contents to compare (note: \"#{label_for(candidate)}\")"
      elsif contents_match?(stored, found)
        say 'contents match the tagged item'
        answer_confirmation(true)
      else
        say "contents differ - tagged item held #{stored.size} item(s), this one holds #{found.size}"
      end
    when 'analyze'
      capture_command("analyze #{target}")
      silent = candidate[:silent_note].to_s.strip
      say "compare the analysis above with the tagged note: \"#{candidate[:note]}\"#{silent.empty? ? '' : " SN: \"#{silent}\""}"
    else
      say 'usage: verify recall | verify analyze | verify look'
    end
  end

  def self.answer_confirmation(yes)
    unless @pending_confirmation
      say "no confirmation is pending"
      return
    end

    if yes
      candidate = @pending_confirmation[:candidates][@pending_confirmation[:index]]
      bind!(@pending_confirmation[:exist_id], candidate[:id])
      update_note(candidate[:id], container: 'carried')
      @last_touched_note_id = candidate[:id]
      say "got it - won't ask again this session"
      @pending_confirmation = nil
    else
      @pending_confirmation[:index] += 1
      ask_current_candidate
    end
  end

  ## ---- upstream command hook -------------------------------------------------

  def self.parse_upstream(command)
    if (m = HOOK_CMD_RX.match(command))
      CMD_QUEUE.push(m[1])
      nil
    else
      command
    end
  end

  def self.install_upstream_hook
    UpstreamHook.add(UPSTREAM_HOOK_ID, proc { |command| parse_upstream(command) })
  end

  def self.remove_upstream_hook
    UpstreamHook.remove(UPSTREAM_HOOK_ID)
  end

  def self.drain_cmd_queue
    handle_command(CMD_QUEUE.pop) until CMD_QUEUE.empty?
  end

  def self.handle_command(msg)
    text = msg.to_s.strip

    case text
    when ''
      report_status
    when /^help$/i
      show_help
    when /^colors?$/i
      show_colors
    when /^list$/i
      list_notes
    when /^(?:yes|y)$/i
      answer_confirmation(true)
    when /^(?:no|n)$/i
      answer_confirmation(false)
    when /^verify\s+(\w+)$/i
      verify_pending($1)
    when /^verify$/i
      say 'usage: verify recall | verify analyze | verify look'
    when /^why(?:\s+(\S+))?$/i
      explain($1)
    when /^stale(?:\s+(\d+))?$/i
      list_stale(($1 || 30).to_i)
    when /^(?:fingerprint|fp)(?:\s+(\S+))?$/i
      fingerprint_held($1)
    when /^tag\s+(.+)$/i
      handle_tag_command($1)
    when /^(?:recall|r)\s+(.+)$/i
      handle_recall_command($1)
    when /^(?:recall|r)$/i
      handle_recall_command(nil)
    when /^set\s+recall\s+(.+)$/i
      set_recall_mode($1)
    when /^color\s+(\w+)$/i
      set_color($1)
    when /^(?:delete|d)\s+(\S+)$/i
      remove_by_token($1)
    when /^(?:delete|d)$/i
      say "usage: delete <noun>  e.g.  delete hatchet"
    when /^silent$/i
      toggle_inventory_only
    else
      say "unrecognized command: #{text.inspect} - try ';isharpie help'"
    end
  rescue StandardError => e
    say "command error: #{e.class}: #{e.message}"
  end

  def self.handle_tag_command(body)
    noun = body[/\A([^\s"]+)/, 1]
    unless noun
      say 'usage: tag <noun> ["<note>"] [SN "<silent note>"] [color <name>]'
      return
    end
    rest      = body.sub(/\A[^\s"]+\s*/, '')
    color     = rest[/\bcolor\s+(\w+)\b/i, 1]
    silent    = rest[/\bSN\s+"([^"]+)"/i, 1]
    cleaned   = rest.gsub(/\bcolor\s+\w+\b/i, '').gsub(/\bSN\s+"[^"]+"/i, '').strip
    note_text = cleaned[/"([^"]+)"/, 1]

    if note_text.nil? && silent.nil?
      say 'usage: tag <noun> ["<note>"] [SN "<silent note>"] [color <name>]'
      return
    end

    tag_held_item(noun, note_text, color, silent)
  end

  def self.handle_recall_command(body)
    noun = body.to_s.strip
    noun = nil if noun.empty?

    item = held_item(noun)
    unless item
      say "you're not holding a #{noun || 'target item'}"
      return
    end

    recall_text = fetch_recall_text(noun || item.noun.to_s)
    summary = summarize_recall(recall_text)
    unless summary && !summary.empty?
      say 'no useful recall details found'
      return
    end

    note_text, silent_note = recall_note_parts(summary)
    tag_item(item, note_text, nil, silent_note, recall_fp: summary)
  end

  # Captures via a temporary DownstreamHook rather than reget - reget scrapes
  # the shared server buffer (vulnerable to unrelated lines crowding out the
  # response in the capture window) and, worse, its XML cleanup deletes the
  # full text content between certain tag pairs (compDef/component/spell/etc),
  # not just the tags - GS wraps some in-line stat callouts (exactly the kind
  # of enchant/ensorcel bonus lines recall produces) in those same tags, so
  # reget silently threw the sentence away along with the tag. A hook sees
  # the raw line before any of that, so we strip tags ourselves (keeping the
  # inner text) instead.
  def self.fetch_recall_text(noun)
    target = noun.to_s.strip.empty? ? 'item' : noun.to_s.strip
    capture_command("recall #{target}").gsub(/<[^>]+>/, '')
  end

  def self.recall_note_parts(summary)
    case recall_mode
    when 'silent'
      [nil, summary]
    when 'both'
      [summary, summary]
    else
      [summary, nil]
    end
  end

  ADJECTIVE_TO_CER = {
    'lightly' => '1-2',
    'fairly' => '3-4',
    'somewhat' => '5-6',
    'decently' => '7-8',
    'heavily' => '9-10',
    'very heavily' => '11-13',
    'exceptionally' => '14-15',
    'masterfully' => '16-20',
    'superbly' => '21-25',
    'expertly' => '26-30',
    'phenomenally' => '31-35',
    'fantastically' => '36-40',
    'incredibly' => '41-45',
    'wondrously' => '46-50'
  }.freeze

  # The adjective captures below are anchored to "\bis\s+" on purpose - without
  # it, a one-word adjective (e.g. "fairly") lets the match start at the
  # sentence's "is" instead of "It", sweeping "is" into the capture itself
  # ("is fairly") and silently missing the ADJECTIVE_TO_CER lookup, always
  # falling back to "?" - confirmed this was happening for every one-word
  # adjective. Two-word adjectives ("very heavily") happened to dodge it since
  # their own true start position already produces a full match.
  def self.extract_cer_tags(text)
    content = text.to_s.gsub(/\e\[[0-9;]*m/, '').gsub(/\s+/, ' ').strip
    return '' if content.empty?

    tags = []

    if content =~ /temporarily serves/i
      tags << 'TEMP'
    end

    if content =~ /\bis\s+(\w+(?:\s+\w+)?)\s+padded\s+to\s+lessen\s+the\s+damage/i
      adj = $1.downcase
      if content =~ /exactly how much requires assessment/i
        tags << 'DAM?'
      else
        range = ADJECTIVE_TO_CER[adj] || '?'
        tags << "DAM#{range}"
      end
    end

    if content =~ /\bis\s+(\w+(?:\s+\w+)?)\s+padded\s+against\s+critical/i
      adj = $1.downcase
      if content =~ /exactly how much requires assessment/i
        tags << 'CRT?'
      else
        range = ADJECTIVE_TO_CER[adj] || '?'
        tags << "CRT#{range}"
      end
    end

    unless tags.any? { |t| t.start_with?('CRT') }
      if content =~ /\bis\s+(\w+(?:\s+\w+)?)\s+weighted\s+to\s+inflict/i
        adj = $1.downcase
        if content =~ /exactly how much requires assessment/i
          tags << 'CRT?'
        else
          range = ADJECTIVE_TO_CER[adj] || '?'
          tags << "CRT#{range}"
        end
      end
    end

    if content =~ /\bis\s+(\w+(?:\s+\w+)?)\s+sighted/i
      adj = $1.downcase
      if content =~ /exactly how much requires assessment/i
        tags << 'SIGT?'
      else
        range = ADJECTIVE_TO_CER[adj] || '?'
        tags << "SIGT#{range}"
      end
    elsif content =~ /sighted\s+to\s+assist/i
      if content =~ /exactly how much requires assessment/i
        tags << 'SIGT?'
      end
    end

    tags.join(',')
  end

  def self.extract_script_name(text)
    content = text.to_s.gsub(/\e\[[0-9;]*m/, '').gsub(/\s+/, ' ').strip
    return nil if content.empty?

    if content =~ /unknown \(scripted\) benefit/i
      return '?'
    end

    tier = content[/It is a tier (\d+)/i, 1]
    
    if content =~ /currently set to\s+([^.]+)/i
      script_name = $1.strip
      return tier ? "Tier #{tier} #{script_name}" : script_name
    end

    if content =~ /It is a tier \d+\s+(.+?)\s+(?:weapon|armor|shield|wps|device|orb|sceptre|figurine|jewelry|ring|bracelet|amulet|brooch|cloak|gloves|boots|leggings|tunic|robe|gown|shirt|pants|coat|jacket|vest|belt|hat|crown|circlet|helm|hood|mask|veil)\b/i
      script_name = $1.strip
      return tier ? "Tier #{tier} #{script_name}" : script_name
    end

    nil
  end

  def self.extract_enhancive_info(text)
    content = text.to_s.gsub(/\e\[[0-9;]*m/, '').gsub(/\s+/, ' ').strip
    return nil unless content =~ /it is an enhancive item/i

    boosts = []
    content.scan(/It provides a boost of (\d+) to ([^.]+?)(?=\.|\n|It provides|This enhancement|It seems)/i) do |match|
      amount = match[0]
      name = match[1].strip
      name = name.sub(/\s+Ranks\s*$/, '')
      boosts << "+#{amount} #{name}"
    end

    return nil if boosts.empty?

    status = if content =~ /will persist after its last enhancive charge/i
               'Persists'
             elsif content =~ /will crumble into dust after its last.*charge/i
               'Crumbles'
             else
               nil
             end

    result = boosts.join(', ')
    result += " #{status}" if status
    result
  end

  def self.extract_imbed_info(text)
    content = text.to_s.gsub(/\e\[[0-9;]*m/, '').gsub(/\s+/, ' ').strip
    return nil if content.empty?

    spell = content[/imbedded with the\s+(\w+)\s+spell/i, 1]
    spell = 'None' if spell.nil? && content =~ /could be imbedded with a spell/i

    return nil if spell.nil?

    current = content[/It has\s+(\d+)\s+charges/i, 1]
    additional = content[/can be charged for an additional\s+(\d+)/i, 1]

    recharge = content =~ /rechargeable/i

    status = if recharge
               'Recharge'
             elsif content =~ /will persist after its last magical charge/i
               'Persists'
             elsif content =~ /will disintegrate after its last.*charge/i
               'Disintegrates'
             else
               nil
             end

    if current && additional
      return "#{spell} #{current}/#{additional} #{status}".strip
    elsif current
      return "#{spell} #{current} #{status}".strip
    elsif spell == 'None'
      return "#{spell} #{status}".strip
    end

    nil
  end

  def self.summarize_recall(text)
    content = text.to_s.gsub(/\e\[[0-9;]*m/, '').gsub(/\s+/, ' ').strip
    return '' if content.empty?

    # "imparts a bonus of +N" is the actual current-value phrasing GS4 uses
    # for weapon/armor enchant bonuses - the word "enchant" itself only shows
    # up elsewhere in the recall text on the crafter-credit line ("was last
    # enchanted by <name>") and the max-cap line ("may be enchanted up to a
    # bonus of N"), neither of which is the current bonus. Falls back to the
    # old enchant-word pattern for item types phrased differently.
    enchant = content[/\bimparts a bonus of \+?(\d+)/i, 1] ||
              content[/\b(?:enchant(?:ed|ment)?)(?:\s+of)?\s*\+?(\d+)/i, 1]
    # GS4 recall never actually says "sorcery" - it reports the sanctify
    # count as "It has been sanctified N times.", the direct parallel to
    # "It has been ensorcelled N times." below. Permanent Holy Fire flares
    # take priority over that count when present: Holy Fire is a tier-6-only
    # flare, a more reliable signal of the true sorcery level than a
    # "times" count that can lag behind (confirmed against a real item:
    # "sanctified 5 times" + Holy Fire flares is actually sorcery 6).
    sorcery = if content =~ /holy fire/i
                '6'
              else
                content[/\bsanctified\s+(\d+)\s+times?/i, 1] ||
                content[/\b(?:sorcery)(?:\s+of)?\s*\+?(\d+)/i, 1]
              end
    ensorcel = content[/\b(?:ensorcel(?:led|ment)?)(?:\s+of)?\s*\+?(\d+)/i, 1]

    # Enchant/sorcery/ensorcel render as one slash-joined group (e.g.
    # "+35/S5/E5", or "+35/E5" when there's no sanctify) - everything else
    # stays space-separated.
    core = []
    core << "+#{enchant}" if enchant
    core << "S#{sorcery}" if sorcery
    core << "E#{ensorcel}" if ensorcel

    parts = []
    parts << core.join('/') unless core.empty?

    cer_tags = extract_cer_tags(content)
    parts << "CER:#{cer_tags}" if cer_tags && !cer_tags.empty?

    script = extract_script_name(content)
    parts << "Script:#{script}" if script

    imbed = extract_imbed_info(content)
    parts << "Imbed:\"#{imbed}\"" if imbed

    enhancive = extract_enhancive_info(content)
    parts << "ENH: #{enhancive}" if enhancive

    parts << "Spiked" if content =~ /it is spiked/i

    return parts.join(' ') unless parts.empty?

    fallback = content.sub(/^as you recall\.\.\.\s*/i, '').split(/(?:\.\s+|!\s+|\?\s+)/).first.to_s.strip
    fallback = fallback.gsub(/\b(?:it|is|has|with|and|the|a|an|of|for|to|on|in|from)\b/i, '')
    fallback = fallback.gsub(/[^a-z0-9\s\/\+\-]/i, ' ').squeeze(' ').strip
    fallback[0, 40]
  end

  ## ---- command handlers -------------------------------------------------------

  def self.held_item(noun = nil)
    both = [GameObj.right_hand, GameObj.left_hand].select { |g| g && g.name && g.name != 'Empty' }
    return both.first unless noun

    both.find { |g| g.noun.to_s.casecmp?(noun) } ||
      both.find { |g| g.name.to_s.downcase.include?(noun.downcase) }
  end

  def self.normalize_color(name)
    name.to_s.strip.downcase
  end

  # Hand slots report a shortened name ("sack" for "large sack", "iron rapier"
  # for "slender iron rapier"). A short stored name matches more items than
  # it should, so look up the full name from a glance, which renders hands
  # with their complete tagged names.
  def self.full_name_for(item)
    base = long_name_for(item)
    text = capture_command('glance', 0.5)
    text.scan(ITEM_TAG_RX) do |exist_id, _noun, tag_text, trailing|
      next unless exist_id == item.id.to_s

      full = "#{tag_text}#{sanitize_trailing(trailing)}".strip
      return full unless full.empty?
    end
    base
  rescue StandardError
    base
  end

  def self.tag_item(item, note_text, color_name, silent_note = nil, recall_fp: nil)
    return unless item

    long_name = full_name_for(item)
    existing  = bound_note_for(item.id)
    color     = color_name ? normalize_color(color_name) : (existing && existing[:color]) || 'none'

    unless VALID_COLORS.include?(color)
      say "unknown color #{color.inspect} - valid: #{VALID_COLORS.join(', ')}"
      return
    end

    label = [note_text && "\"#{note_text.strip}\"",
             silent_note && "SN: \"#{silent_note.strip}\""].compact.join(' ')

    fingerprints = {}
    fingerprints[:recall_fp]   = recall_fp if recall_fp && !recall_fp.empty?
    contents = contents_fingerprint(item)
    fingerprints[:contents_fp] = contents if contents

    if existing
      changes = { color: color }.merge(fingerprints)
      changes[:note]        = note_text.strip   if note_text
      changes[:silent_note] = silent_note.strip if silent_note
      update_note(existing[:id], **changes)
      @last_touched_note_id = existing[:id]
      say "updated #{long_name}: #{label}"
    else
      record = add_note(long_name: long_name, container: 'carried',
                        note: note_text&.strip, color: color,
                        silent_note: silent_note&.strip)
      update_note(record[:id], **fingerprints) unless fingerprints.empty?
      bind!(item.id, record[:id], where: 'carried')
      @last_touched_note_id = record[:id]
      say "tagged #{long_name}: #{label}"
    end
    warn_identical(item, long_name)
  end

  def self.warn_identical(item, long_name)
    twins = twin_ids(item.id, item.name, nil, carried_entries)
    return if twins.empty?

    say "heads up: you carry #{twins.size} other item(s) identical to this #{long_name} - " \
        "use ;isharpie fp while holding the tagged one to store a fingerprint for telling them apart"
  end

  # Re-records the recall and contents fingerprints for the tagged item in hand.
  def self.fingerprint_held(noun)
    item = held_item(noun)
    return say("you're not holding #{noun ? "a #{noun}" : 'anything'}") unless item

    note = bound_note_for(item.id)
    return say("#{long_name_for(item)} isn't identified as a tagged item - tag it or confirm it first") unless note

    changes = {}
    summary = summarize_recall(capture_command("recall ##{item.id}").gsub(/<[^>]+>/, '')).to_s
    changes[:recall_fp] = summary unless summary.empty?
    contents = contents_fingerprint(item)
    changes[:contents_fp] = contents if contents
    return say('nothing usable to fingerprint (no recall or contents)') if changes.empty?

    update_note(note[:id], **changes)
    parts = []
    parts << "recall: #{changes[:recall_fp]}" if changes[:recall_fp]
    parts << "contents: #{changes[:contents_fp].size} item(s)" if changes[:contents_fp]
    say "fingerprint stored for \"#{label_for(note)}\" - #{parts.join(', ')}"
  end

  # Diagnostics: how the item in hand is (or isn't) being matched.
  def self.explain(noun)
    item = held_item(noun)
    return say("you're not holding #{noun ? "a #{noun}" : 'anything'}") unless item

    long  = long_name_for(item)
    note  = bound_note_for(item.id)
    cands = name_candidates(long, item.name.to_s)
    twins = twin_ids(item.id, item.name, nil, carried_entries)
    say "#{long} (id #{item.id})"
    say(note ? "identified as #{note[:id]} \"#{label_for(note)}\"" : 'not identified as a tagged item this session')
    if cands.empty?
      say 'no note matches this name'
    else
      cands.each do |c|
        fps = []
        fps << 'recall' unless c[:recall_fp].to_s.empty?
        fps << "contents(#{c[:contents_fp].size})" if c[:contents_fp]
        say "  name match #{c[:id]}: #{c[:long_name]} - last tracked in #{c[:container] || '?'}, " \
            "fingerprints: #{fps.empty? ? 'none' : fps.join(', ')}"
      end
    end
    say "identical items on you: #{twins.size}"
  end

  def self.list_stale(days)
    cutoff = Time.now.to_i - (days * 86_400)
    stale = notes.select { |n| (n[:last_seen] || n[:created_at]).to_i < cutoff }
    return say("every note has been seen in the last #{days} day(s)") if stale.empty?

    say "#{stale.size} note(s) not seen in #{days}+ day(s):"
    stale.each do |n|
      seen = n[:last_seen] ? Time.at(n[:last_seen]).strftime('%Y-%m-%d') : 'never (since v1.4)'
      where = n[:last_seen_where] || n[:container]
      _respond "  #{n[:id]}: #{n[:long_name]} \"#{label_for(n)}\" - last seen #{seen}#{where ? " (#{where})" : ''}"
    end
    say 'nothing is deleted automatically - use ;isharpie delete <id> to remove one'
  end

  # After the startup container preload, re-identify tagged items on the
  # character. Ids don't survive a login, so this uses the name, then the
  # contents fingerprint, then the container each note was last tracked in -
  # and binds only when exactly one item fits.
  def self.restore_bindings
    entries  = carried_entries
    restored = 0
    unsure   = 0
    notes.each do |note|
      next if @exist_bindings.value?(note[:id])

      matches = entries.select do |o, _|
        name_candidates(long_name_for(o), o.name.to_s).any? { |c| c[:id] == note[:id] }
      end
      next if matches.empty?

      pick = nil
      if matches.size > 1
        by_contents = matches.select { |o, _| contents_match?(note[:contents_fp], known_contents(o.id)) }
        pick = by_contents.first if by_contents.size == 1
        unless pick
          by_container = matches.select { |_, loc| loc == note[:container] }
          pick = by_container.first if by_container.size == 1
        end
      elsif container_agrees?(note[:container], matches.first[1], on_person_names(entries))
        pick = matches.first
      end

      if pick && !@exist_bindings.key?(pick[0].id.to_s)
        bind!(pick[0].id, note[:id], where: 'carried')
        restored += 1
      elsif matches.size > 1
        unsure += 1
      end
    end
    say "re-identified #{restored} tagged item(s)#{unsure.positive? ? ", #{unsure} ambiguous (identical copies)" : ''}" if restored + unsure > 0
  rescue StandardError => e
    say "restore warning: #{e.message}"
  end

  def self.tag_held_item(noun, note_text, color_name, silent_note = nil)
    item = held_item(noun)
    unless item
      say "you're not holding a #{noun}"
      return
    end

    tag_item(item, note_text, color_name, silent_note)
  end

  def self.set_color(color_name)
    color = normalize_color(color_name)
    unless VALID_COLORS.include?(color)
      say "unknown color #{color.inspect} - valid: #{VALID_COLORS.join(', ')}"
      return
    end

    unless @last_touched_note_id
      say "nothing tagged/confirmed yet this session to color - tag an item first"
      return
    end

    update_note(@last_touched_note_id, color: color)
    say "color set to #{color}"
  end

  def self.remove_held_item(noun)
    item = held_item(noun)
    unless item
      say "you're not holding a #{noun}"
      return
    end

    long_name = long_name_for(item)
    existing = bound_note_for(item.id)
    candidates = existing ? [existing] : candidates_for(long_name)

    if candidates.empty?
      say "no note found for #{long_name}"
    elsif candidates.size == 1
      remove_note(candidates.first[:id])
      say "removed note for #{long_name}"
    else
      @last_ambiguous_list = candidates
      listing = candidates.each_with_index.map { |c, i| "#{i + 1}) #{c[:note]}" }.join(', ')
      say "multiple notes match #{long_name} - #{listing} - then ';isharpie delete <n>'"
    end
  end

  def self.remove_by_token(token)
    # Numeric index from a previous ambiguous-list prompt
    idx = token.to_i
    if idx.nonzero? && @last_ambiguous_list && @last_ambiguous_list[idx - 1]
      record = @last_ambiguous_list[idx - 1]
      remove_note(record[:id])
      say "removed note: #{record[:note]}"
      @last_ambiguous_list = nil
      return
    end

    # Literal note id (e.g. n5)
    if token =~ /^n\d+$/i
      record = notes.find { |n| n[:id] == token }
      if record
        remove_note(record[:id])
        say "removed note: #{record[:note]}"
      else
        say "no note found with id #{token}"
      end
      return
    end

    # Otherwise treat as noun - find item in hand
    remove_held_item(token)
  end

  def self.list_notes
    if notes.empty?
      say "no notes stored"
      return
    end

    notes.each { |n|
      visible = n[:note].to_s.strip
      silent  = n[:silent_note].to_s.strip
      
      item_name = Lich::Messaging.msg_format('yellow', n[:long_name], encode: false)
      container = Lich::Messaging.msg_format('green', "[#{n[:container]}]", encode: false)
      
      label_parts = []
      label_parts << Lich::Messaging.msg_format('teal', visible, encode: false) unless visible.empty?
      label_parts << "SN: #{silent}" unless silent.empty?
      label = label_parts.join(' | ')
      
      line = "#{n[:id]}: #{item_name} #{container} -> #{label} (#{n[:color]})"
      _respond line
    }
  end

  def self.show_colors
    VALID_COLORS.each do |c|
      _respond(c == 'none' ? '  none' : "  #{Lich::Messaging.msg_format(COLOR_MAP[c], c, encode: false)}")
    end
  end

  def self.show_help
    t = proc { |s| Lich::Messaging.msg_format('thought', s, encode: false) }
    b = proc { |s| Lich::Messaging.msg_format('bold',    s, encode: false) }
    w = proc { |s| Lich::Messaging.msg_format('whisper', s, encode: true)  }

    _respond t.call("  ISharpie (Item Sharpie) v#{VERSION}  -  Help Notes")
    _respond ''
    _respond '  ISharpie tags held items with a displayed note and/or a hidden note, then injects'
    _respond '  that note inline wherever it appears in game text, or just in inventory (flag option).'
    _respond '  Name your weapons and see the name in game!'
    _respond '  Track your weapon and armor CER services in a hidden note, viewed through the list function!'
    _respond '  List the enhancive benefits of your items right next to their name!'
    _respond ''
    _respond b.call('  -- Usage --') + '  (hold item first. You can add tag, SN, and color all in one command)'
    _respond "  #{w.call(';isharpie tag <noun> "<note>"')}  tag item in hand"
    _respond "  #{w.call(';isharpie tag <noun> SN "<note>"')}  silent note - shows in list only, no inline tag"
    _respond "  #{w.call(';isharpie recall <noun>')}  recall item and automatically add summary notes based off toggle logic below"
    _respond "  #{w.call(';isharpie color <name>')}  update color on last tagged"
    _respond "  #{w.call(';isharpie delete <noun>')}  remove note from item in hand (or ;isharpie d <noun>)"
    _respond "  #{w.call(';isharpie list')}  list all stored notes"
    _respond "  #{w.call(';isharpie why <noun>')}  explain how the item in hand is being matched"
    _respond "  #{w.call(';isharpie fp <noun>')}  store a recall/contents fingerprint for the tagged item in hand"
    _respond "  #{w.call(';isharpie stale [days]')}  list notes not seen in a while (default 30 days)"
    _respond ''
    _respond b.call('  -- Identical Items --')
    _respond "  When you own identical copies, each shows (#{AMBIGUOUS_TEXT}) until one is identified."
    _respond '  Picking up an unidentified copy asks you to verify it:'
    _respond "  #{w.call(';isharpie verify recall')} / #{w.call('verify analyze')} / #{w.call('verify look')}  then  #{w.call(';isharpie yes')} or #{w.call(';isharpie no')}"
    _respond '  A stored fingerprint (from ;isharpie recall or ;isharpie fp) lets a match confirm itself.'
    _respond ''
    _respond b.call('  -- Toggles --')
    _respond "  #{w.call(';isharpie set recall loud')}      - notes appear inline with item names (default)"
    _respond "  #{w.call(';isharpie set recall silent')}    - notes appear in list only, not inline"
    _respond "  #{w.call(';isharpie set recall both')}      - notes appear both inline and in list"
    _respond "  #{w.call(';isharpie silent')}  toggle silent mode (notes show only on your own items)"
    _respond ''
    _respond b.call('  -- Colors --')
    VALID_COLORS.each do |c|
      _respond(c == 'none' ? '  none' : "  #{Lich::Messaging.msg_format(COLOR_MAP[c], c, encode: false)}")
    end
    _respond ''
    _respond b.call('  -- Recall Feature --')
    _respond '  Hold an item and use ;isharpie recall (or ;isharpie r) to automatically parse its recall'
    _respond '  output and create a compact summary note with enchantment, sorcery, ensorcelment, CER,'
    _respond '  scripts, imbed spells, enhancives, and other properties. Saves manual typing!'
    _respond ''
    _respond b.call('  -- Notes --')
    _respond '  item id resets each login, after locker storage, or scripted item mutations - matched automatically by name'
    _respond '  Otherwise, confirmation prompt only fires when identical items make the match uncertain'
    _respond '  If struggling with syntax, ensure note text is in quotes and include "color" when changing it'
    _respond ''
  end

  def self.report_status
    pending = if @pending_confirmation
                candidate = @pending_confirmation[:candidates][@pending_confirmation[:index]]
                "a confirmation is pending (\"#{candidate && candidate[:note]}\")"
              else
                "no confirmation pending"
              end
    say "v#{VERSION} - #{notes.size} note(s) stored - #{pending}"
  end

  ## ---- misc -------------------------------------------------------------------

  def self.say(message)
    _respond Lich::Messaging.msg_format('whisper', "[ISharpie: #{message}]", encode: false)
  end

  def self.main_loop
    loop do
      begin
        drain_cmd_queue
        drain_confirm_queue
        if @dirty
          @dirty = false
          save_notes!
        end
      rescue StandardError => e
        say "error in main loop: #{e.class}: #{e.message}"
      end
      pause 0.25
    end
  end
end

if Script.current.vars[1] =~ /^help$/i
  ISharpie.show_help
  exit
end

ISharpie.install_annotator
ISharpie.install_container_tracker
ISharpie.install_upstream_hook

before_dying do
  ISharpie.remove_annotator
  ISharpie.remove_container_tracker
  ISharpie.remove_upstream_hook
end

ISharpie.preload_containers
ISharpie.restore_bindings
respond("ISharpie is running!")
ISharpie.main_loop
